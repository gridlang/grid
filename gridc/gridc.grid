// gridc — the Grid compiler, written in Grid (bootstrapped on gridi).
//
//   gridi gridc.grid  <source.grid>  <out.ll>
//
// Emits LLVM IR text; `clang out.ll -o bin` links a native binary.
//
// C1 (this rung): compile `main := () -> int { <int-literal> }` to a native that
// exits with that int. The front end here is deliberately crude (string slicing);
// C2/C3/C4 replace it with a real lexer / parser / codegen.
module main

import fs
import str
import sys

// --- codegen : wrap an i64 return value as a complete module ----------
// LLVM IR is brace-heavy, so build it with plain "..." concatenation (a backtick
// string would read `{` as an interpolation delimiter).
emit_main := (ret: str) -> str {
  "; gridc\n" +
  "define i64 @main() {\n" +
  "entry:\n" +
  "  ret i64 " + ret + "\n" +
  "}\n"
}

// --- C1 front end : pull the integer literal out of the main body -----
compile := (src: str) -> str {
  after := str.split(src, "{")[1]            // text after the first {
  body  := str.trim(str.split(after, "}")[0]) // text before the next }  ->  "42"
  emit_main(body)
}

main := (args: [str]) -> int {
  src := fs.read(args[0])
  fs.write(args[1], compile(src))
  0
}
