// gridc — the Grid compiler, written in Grid (bootstrapped on gridi).
//
//   gridi gridc.grid  <source.grid>  <out.ll>
//
// Emits LLVM IR text; `clang out.ll -o bin` links a native binary.
//
// Rungs: C1 literal · C2 lexer · C3 parser · C4 arithmetic ·
//        C5a immutable locals · C5b mutable locals + stores · C5c functions + calls.
//
// Subset compiled: a program is one or more `name := (params) -> int { stmts }`
// functions over i64; stmts are lets / stores / in-place / a final result expr;
// exprs are integer arithmetic, locals, and calls. `main` is the entry point.
//
// Note: `?:` ladders put the `:` at the END of a line (a newline after `:`
// continues; a newline after `}` would end the statement).
module main

import fs
import sys

// ── lexer ────────────────────────────────────────────────────────────
digit := (c: str) -> str { c >= "0" && c <= "9" }
alpha := (c: str) -> str { (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_" }
space := (c: str) -> str { c == " " || c == "\t" || c == "\r" }

scan := (src: str, start: int, n: int, p: (str) -> str) -> (str, int) {
  text: &str := ""
  j: &int := start
  { j < n && p(src[j]) } @ { text = text + src[j]; j += 1; () }
  (text, j)
}

// read a "double-quoted" literal starting just past the opening quote; decode
// the common escapes and return (decoded-text, index just past the close quote).
scan_str := (src: str, start: int, n: int) -> (str, int) {
  text: &str := ""
  j: &int := start
  { j < n && src[j] != "\"" } @ {
    src[j] == "\\" && j + 1 < n ? {
      e := src[j + 1]
      text = text + (e == "n" ? "\n" : e == "t" ? "\t" : e == "r" ? "\r" : e)
      j += 2
    } :
    { text = text + src[j]; j += 1 }
    ()
  }
  (text, j + 1)
}

lex := (src: str) -> [(str, str)] {
  toks: &[(str, str)] := []
  i: &int := 0
  n := src.len
  { i < n } @ {
    c := src[i]
    (c == "\n" || c == ";") ? { toks = toks + [("nl", "nl")]; i += 1 } :
    space(c) ? { i += 1 } :
    digit(c) ? { t, j := scan(src, i, n, digit); toks = toks + [("int", t)]; i = j } :
    alpha(c) ? { t, j := scan(src, i, n, alpha); toks = toks + [("name", t)]; i = j } :
    c == "\"" ? { t, j := scan_str(src, i + 1, n); toks = toks + [("str", t)]; i = j } :
    {
      two := i + 1 < n ? src[i] + src[i + 1] : ""
      two == "//" ? { { i < n && src[i] != "\n" } @ { i += 1; () } } :
      (two == ":=" || two == "->" || two == "=>" || two == ".." ||
       two == "+=" || two == "-=" || two == "*=" || two == "/=" ||
       two == "==" || two == "!=" || two == "<=" || two == ">=" ||
       two == "&&" || two == "||") ? {
        toks = toks + [(two, two)]; i += 2
      } :
      { toks = toks + [(c, c)]; i += 1 }
    }
    ()
  }
  toks
}

// ── parser ───────────────────────────────────────────────────────────
// expr: ("int",v) ("name",x) ("bin",op,l,r) ("call",name,[args])
// stmt: ("let",n,e) ("store",n,e) ("inplace",n,op,e) ("ret",e)
// top:  ("fn", name, [params], [stmts])

tkind := (toks: [(str, str)], pos: int) -> str { pos < toks.len ? toks[pos].0 : "eof" }
ttext := (toks: [(str, str)], pos: int) -> str { toks[pos].1 }

mulop := (k: str) -> str { k == "*" || k == "/" || k == "%" }
addop := (k: str) -> str { k == "+" || k == "-" }
cmpop := (k: str) -> str { k == "==" || k == "!=" || k == "<" || k == "<=" || k == ">" || k == ">=" }
boolop := (k: str) -> str { k == "&&" || k == "||" }
inplaceop := (k: str) -> str { k == "+=" || k == "-=" || k == "*=" || k == "/=" }

parse_args := (toks: [(str, str)], pos: int) -> ([(str, str)], int) {
  args: &[(str, str)] := []
  cur: &int := pos
  { tkind(toks, cur) != ")" && tkind(toks, cur) != "eof" } @ {
    node, p := parse_expr(toks, cur)
    args = args + [node]
    cur = tkind(toks, p) == "," ? p + 1 : p
    ()
  }
  (args, cur + 1)
}

parse_atom := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  k := tkind(toks, pos)
  k == "int" ? (("int", ttext(toks, pos)), pos + 1) :
  k == "str" ? (("str", ttext(toks, pos)), pos + 1) :
  k == "name" ? {
    tkind(toks, pos + 1) == "(" ? {
      args, p := parse_args(toks, pos + 2)
      (("call", ttext(toks, pos), args), p)
    } :
    (("name", ttext(toks, pos)), pos + 1)
  } :
  k == "[" ? {
    tkind(toks, pos + 1) == "]" ? (("list", []), pos + 2) :   // empty list
    {
      elems: &[(str, str)] := []
      cur: &int := pos + 1
      { tkind(toks, cur) != "]" && tkind(toks, cur) != "eof" } @ {
        e, p := parse_expr(toks, cur)
        elems = elems + [e]
        cur = tkind(toks, p) == "," ? p + 1 : p
        ()
      }
      (("list", elems), cur + 1)
    }
  } :
  k == "(" ? {
    first, p := parse_expr(toks, pos + 1)
    tkind(toks, p) == "," ? {                          // (a, b, ...) tuple
      elems: &[(str, str)] := [first]
      cur: &int := p
      { tkind(toks, cur) == "," } @ {
        e, p2 := parse_expr(toks, cur + 1)
        elems = elems + [e]
        cur = p2
        ()
      }
      (("tuple", elems), cur + 1)
    } :
    (first, p + 1)                                      // plain (expr)
  } :
  (("int", "0"), pos + 1)
}

// postfix chain: atom ( .member | [index] )*
parse_postfix := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  node, p := parse_atom(toks, pos)
  acc: &(str, str) := node
  cur: &int := p
  { tkind(toks, cur) == "." || tkind(toks, cur) == "[" } @ {
    tkind(toks, cur) == "." ? {
      acc = ("member", acc, ttext(toks, cur + 1))
      cur = cur + 2
    } :
    {
      idx, p2 := parse_expr(toks, cur + 1)
      acc = ("index", acc, idx)
      cur = p2 + 1                                      // skip ]
    }
    ()
  }
  (acc, cur)
}

parse_mul := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  node, p := parse_postfix(toks, pos)
  acc: &(str, str) := node
  cur: &int := p
  { mulop(tkind(toks, cur)) } @ {
    op := ttext(toks, cur)
    rhs, p2 := parse_postfix(toks, cur + 1)
    acc = ("bin", op, acc, rhs)
    cur = p2
    ()
  }
  (acc, cur)
}

parse_add := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  node, p := parse_mul(toks, pos)
  acc: &(str, str) := node
  cur: &int := p
  { addop(tkind(toks, cur)) } @ {
    op := ttext(toks, cur)
    rhs, p2 := parse_mul(toks, cur + 1)
    acc = ("bin", op, acc, rhs)
    cur = p2
    ()
  }
  (acc, cur)
}

// range: a .. b  ->  ("range", a, b)
parse_range := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  l, p := parse_add(toks, pos)
  tkind(toks, p) == ".." ? {
    r, p2 := parse_add(toks, p + 1); (("range", l, r), p2)
  } :
  (l, p)
}

// a single relation (no chaining yet): ("rel", op, l, r)
parse_cmp := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  l, p := parse_range(toks, pos)
  cmpop(tkind(toks, p)) ? {
    r, p2 := parse_range(toks, p + 1); (("rel", ttext(toks, p), l, r), p2)
  } :
  (l, p)
}

// boolean selectors && / || , looser than comparison
parse_bool := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  l, p := parse_cmp(toks, pos)
  acc: &(str, str) := l
  cur: &int := p
  { boolop(tkind(toks, cur)) } @ {
    op := ttext(toks, cur)
    r, p2 := parse_cmp(toks, cur + 1)
    acc = ("bin", op, acc, r)
    cur = p2
    ()
  }
  (acc, cur)
}

// the combinators: source @ body / source # body -> ("iter", op, source, body)
parse_comb := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  l, p := parse_bool(toks, pos)
  acc: &(str, str) := l
  cur: &int := p
  { tkind(toks, cur) == "@" || tkind(toks, cur) == "#" } @ {
    op := ttext(toks, cur)
    body, p2 := parse_armbody(toks, cur + 1)
    acc = ("iter", op, acc, body)
    cur = p2
    ()
  }
  (acc, cur)
}

// a combinator body: ( name => stmt ) -> ("arm", name, stmt) ; else ( expr )
parse_armbody := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  tkind(toks, pos) == "(" && tkind(toks, pos + 1) == "name" && tkind(toks, pos + 2) == "=>" ? {
    s, p := parse_stmt(toks, pos + 3); (("arm", ttext(toks, pos + 1), s), p + 1)
  } :
  { node, p := parse_expr(toks, pos + 1); (node, p + 1) }
}

// cond ? then : else  ->  ("if", cond, then, else)   (loosest, right-assoc)
// cond ? then         ->  ("try", cond, then)        (one-armed: present or ())
parse_ternary := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  cond, p := parse_comb(toks, pos)
  tkind(toks, p) == "?" ? {
    then, p2 := parse_expr(toks, p + 1)
    tkind(toks, p2) == ":" ? {
      els, p3 := parse_expr(toks, p2 + 1); (("if", cond, then, els), p3)
    } :
    (("try", cond, then), p2)
  } :
  (cond, p)
}

parse_expr := (toks: [(str, str)], pos: int) -> ((str, str), int) { parse_ternary(toks, pos) }

skip_nl := (toks: [(str, str)], pos: int) -> int {
  cur: &int := pos
  { tkind(toks, cur) == "nl" } @ { cur += 1; () }
  cur
}

// skip a type annotation `: ... :=`, returning the index just past `:=`.
skip_type := (toks: [(str, str)], pos: int) -> int {
  cur: &int := pos
  { tkind(toks, cur) != ":=" && tkind(toks, cur) != "eof" } @ { cur += 1; () }
  cur + 1
}

parse_stmt := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  k0 := tkind(toks, pos)
  k1 := tkind(toks, pos + 1)
  k0 == "name" && k1 == "," ? {                        // a, b, ... := tuple-expr
    names: &[str] := [ttext(toks, pos)]
    cur: &int := pos + 1
    { tkind(toks, cur) == "," } @ {
      names = names + [ttext(toks, cur + 1)]
      cur = cur + 2
      ()
    }
    node, p := parse_expr(toks, cur + 1)               // cur is at :=
    (("destruct", names, node), p)
  } :
  k0 == "name" && k1 == ":=" ? {
    node, p := parse_expr(toks, pos + 2); (("let", ttext(toks, pos), node), p)
  } :
  k0 == "name" && k1 == ":" ? {                        // name: Type := expr
    ty, tp := parse_type(toks, pos + 2)                // tp lands on :=
    node, p := parse_expr(toks, tp + 1)
    (("letty", ttext(toks, pos), ty, node), p)
  } :
  k0 == "name" && k1 == "=" ? {
    node, p := parse_expr(toks, pos + 2); (("store", ttext(toks, pos), node), p)
  } :
  k0 == "name" && inplaceop(k1) ? {
    node, p := parse_expr(toks, pos + 2); (("inplace", ttext(toks, pos), k1, node), p)
  } :
  { node, p := parse_expr(toks, pos); (("ret", node), p) }
}

parse_body := (toks: [(str, str)], pos: int) -> ([(str, str)], int) {
  stmts: &[(str, str)] := []
  cur: &int := skip_nl(toks, pos)
  { tkind(toks, cur) != "}" && tkind(toks, cur) != "eof" } @ {
    s, p := parse_stmt(toks, cur)
    stmts = stmts + [s]
    cur = skip_nl(toks, p)
    ()
  }
  (stmts, cur)
}

// a type annotation -> a structured type (scalar string / ("tup",[..]) /
// ("lst",elem) / ("fn",ret)). Storage capabilities (&/*) and fallible error
// channels (! E) don't affect the value rep, so they're stripped here.
parse_type := (toks: [(str, str)], pos: int) -> (str, int) {
  k := tkind(toks, pos)
  (k == "&" || k == "*") ? parse_type(toks, pos + 1) :
  k == "[" ? {
    el, p := parse_type(toks, pos + 1)                // [ elem ]
    parse_type_suffix(toks, p + 1, ("lst", el))
  } :
  k == "(" ? {
    tkind(toks, pos + 1) == ")" ? {                   // () or () -> R
      tkind(toks, pos + 2) == "->" ? {
        r, p := parse_type(toks, pos + 3); (("fn", r), p)
      } :
      ("i64", pos + 2)
    } :
    {
      tys: &[str] := []
      cur: &int := pos + 1
      { tkind(toks, cur) != ")" && tkind(toks, cur) != "eof" } @ {
        t, p := parse_type(toks, cur)
        tys = tys + [t]
        cur = tkind(toks, p) == "," ? p + 1 : p
        ()
      }
      after := cur + 1                                 // past )
      tkind(toks, after) == "->" ? {                   // (params) -> R  function type
        r, p := parse_type(toks, after + 1); (("fn", r), p)
      } :
      tys.len == 1 ? parse_type_suffix(toks, after, tys[0]) :
      parse_type_suffix(toks, after, ("tup", tys))
    }
  } :
  k == "name" ? {
    base := ttext(toks, pos) == "str" ? "str" : "i64"  // int + all sized ints -> i64
    parse_type_suffix(toks, pos + 1, base)
  } :
  ("i64", pos + 1)
}

// after a base type: an optional `! ErrType` fallible channel (error ignored).
parse_type_suffix := (toks: [(str, str)], pos: int, base: str) -> (str, int) {
  tkind(toks, pos) == "!" ? { e, p := parse_type(toks, pos + 1); (base, p) } :
  (base, pos)
}

// params -> [(name, type)], stopping just past the closing ')'.
parse_params := (toks: [(str, str)], pos: int) -> ([str], int) {
  ps: &[(str, str)] := []
  cur: &int := pos
  { tkind(toks, cur) != ")" && tkind(toks, cur) != "eof" } @ {
    nm := ttext(toks, cur)
    ty, p := tkind(toks, cur + 1) == ":" ? parse_type(toks, cur + 2) : ("i64", cur + 1)
    ps = ps + [(nm, ty)]
    cur = tkind(toks, p) == "," ? p + 1 : p
    ()
  }
  (ps, cur + 1)
}

// name := ( params ) -> rettype { stmts }
parse_fn := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  name := ttext(toks, pos)
  params, p1 := parse_params(toks, pos + 3)        // skip name := (
  rty, p2 := tkind(toks, p1) == "->" ? parse_type(toks, p1 + 1) : ("i64", p1)
  b: &int := p2
  { tkind(toks, b) != "{" && tkind(toks, b) != "eof" } @ { b += 1; () }
  stmts, p3 := parse_body(toks, b + 1)
  (("fn", name, params, rty, stmts), p3 + 1)
}

parse_program := (toks: [(str, str)]) -> [(str, str)] {
  fns: &[(str, str)] := []
  cur: &int := skip_nl(toks, 0)
  { tkind(toks, cur) != "eof" } @ {
    f, p := parse_fn(toks, cur)
    fns = fns + [f]
    cur = skip_nl(toks, p)
    ()
  }
  fns
}

// ── codegen ──────────────────────────────────────────────────────────
llop := (op: str) -> str {
  op == "+" ? "add" : op == "-" ? "sub" : op == "*" ? "mul" : op == "/" ? "sdiv" :
  op == "&&" ? "and" : op == "||" ? "or" : "srem"
}
iop := (k: str) -> str { k == "+=" ? "+" : k == "-=" ? "-" : k == "*=" ? "*" : "/" }
relpred := (op: str) -> str {
  op == "==" ? "eq" : op == "!=" ? "ne" : op == "<" ? "slt" :
  op == "<=" ? "sle" : op == ">" ? "sgt" : "sge"
}

// env entries are (name, slot-ptr, type); look up the slot or the type by name.
lookup := (env: [(str, str)], name: str) -> str { env @ ((n, s, t) => n == name ? s) }
lookup_type := (env: [(str, str)], name: str) -> str { env @ ((n, s, t) => n == name ? t) }

// render a decoded string for an LLVM c"..." literal. Test inputs are printable
// ASCII; proper \NN escaping of specials/controls comes with self-host.
escape_ll := (s: str) -> str { s }

// ── types ────────────────────────────────────────────────────────────
// A type is either a scalar string ("i64" | "str") or a compound tuple:
// ("tup", [fieldtypes]) for tuples, ("lst", elemtype) for lists. Both str
// and list lower to the fat value {i64, ptr}; a tuple to a flat LLVM struct.
fieldnum := (s: str) -> int {
  s == "0" ? 0 : s == "1" ? 1 : s == "2" ? 2 : s == "3" ? 3 :
  s == "4" ? 4 : s == "5" ? 5 : s == "6" ? 6 : 7
}

lltype := (t: str) -> str {
  t == "i64" ? "i64" :
  t == "str" ? "{i64, ptr}" :
  t.0 == "lst" ? "{i64, ptr}" :
  "{" + tup_ll(t.1) + "}"
}

tup_ll := (fields: [str]) -> str {
  out: &str := ""
  fields @ (i: f => { out = out + (i == 0 ? "" : ", ") + lltype(f); () })
  out
}

tup_field := (t: str, i: int) -> str { t.1[i] }
elemtype := (t: str) -> str { t.1 }                  // ("lst", elem) -> elem

// the zero / () value of a type, for store into a freshly-allocated slot.
zerov := (t: str) -> str { t == "i64" ? "0" : "zeroinitializer" }

// gen a condition -> (instructions, i1 tag, counter). A relation is an icmp;
// any other (present) value is the constant `true`.
gen_cond := (node: (str, str), env: [(str, str)], c: int) -> (str, str, int) {
  node.0 == "rel" ? {
    la, lv, lf, lt, c1 := gen_expr(node.2, env, c)
    ra, rv, rf, rt, c2 := gen_expr(node.3, env, c1)
    lt == "str" ? {                                    // compare via __strcmp
      sc := `%t{c2}`
      tag := `%t{c2 + 1}`
      (la + ra + "  " + sc + " = call i64 @__strcmp({i64, ptr} " + lv + ", {i64, ptr} " + rv + ")\n" +
       "  " + tag + " = icmp " + relpred(node.1) + " i64 " + sc + ", 0\n", tag, c2 + 2)
    } :
    {
      tag := `%t{c2}`
      (la + ra + "  " + tag + " = icmp " + relpred(node.1) + " i64 " + lv + ", " + rv + "\n",
       tag, c2 + 1)
    }
  } :
  { e, v, vf, vt, c1 := gen_expr(node, env, c)         // any other value: truthy test
    tag := `%t{c1}`
    (e + "  " + tag + " = icmp ne i64 " + v + ", 0\n", tag, c1 + 1) }
}

// gen each call argument, returning (instructions, "i64 a, i64 b", counter).
gen_args := (args: [(str, str)], env: [(str, str)], c0: int) -> (str, str, int) {
  ir:  &str := ""
  ops: &str := ""
  c:   &int := c0
  args @ (i: a => {
    a2, op, af, at, c2 := gen_expr(a, env, c)
    ir = ir + a2
    ops = ops + (i == 0 ? "" : ", ") + lltype(at) + " " + op
    c = c2
    ()
  })
  (ir, ops, c)
}

// gen a sequence of expressions -> (instructions, [operands], [types], counter).
gen_elems := (elems: [(str, str)], env: [(str, str)], c0: int) -> (str, [str], [str], int) {
  ir:  &str := ""
  ops: &[str] := []
  tys: &[str] := []
  c:   &int := c0
  elems @ (e => {
    ei, eo, ef, et, c2 := gen_expr(e, env, c)
    ir  = ir + ei
    ops = ops + [eo]
    tys = tys + [et]
    c   = c2
    ()
  })
  (ir, ops, tys, c)
}

// the first-success ("find") tail shared by range and list `@`: given the loop
// `head` (ending in the body + its present-flag), the `step` that advances and
// re-loops, and the arm's payload (bop : bty), stop at the first present result
// and carry (payload, flag) out. -> (ir, value, flag, type, counter).
gen_find := (head: str, step: str, L: str, bop: str, bflag: str, bty: str, c: int) -> (str, str, str, str, int) {
  rty := lltype(bty)
  z   := zerov(bty)
  vp := "%fp" + L
  fp := "%ff" + L
  v  := "%fv" + L
  f  := "%fg" + L
  loop := "  " + vp + " = alloca " + rty + "\n  store " + rty + " " + z + ", ptr " + vp + "\n" +
    "  " + fp + " = alloca i1\n  store i1 false, ptr " + fp + "\n" +
    head +
    "  br i1 " + bflag + ", label %hit" + L + ", label %cont" + L + "\n" +
    "hit" + L + ":\n  store " + rty + " " + bop + ", ptr " + vp +
      "\n  store i1 true, ptr " + fp + "\n  br label %le" + L + "\n" +
    "cont" + L + ":\n" + step +
    "le" + L + ":\n  " + v + " = load " + rty + ", ptr " + vp +
      "\n  " + f + " = load i1, ptr " + fp + "\n"
  (loop, v, f, bty, c)
}

// gen_expr -> (instructions, value-operand, i1 present-flag, type, next-counter).
// type is "i64" or "str"; `flag` is "true" for an always-present value, a
// dynamic i1 for a one-armed `?` or an `@` find.
gen_expr := (node: (str, str), env: [(str, str)], c: int) -> (str, str, str, str, int) {
  node.0 == "int"  ? ("", node.1, "true", "i64", c) :
  node.0 == "str"  ? {                                  // literal -> fat {len, ptr}
    txt := node.1
    ln  := txt.len
    lns := `{ln}`
    p  := `%t{c}`
    v  := `%t{c + 1}`
    v2 := `%t{c + 2}`
    head := "  " + p + " = call ptr @__alloc(i64 " + lns + ")\n"
    store := ln == 0 ? "" :
      "  store [" + lns + " x i8] c\"" + escape_ll(txt) + "\", ptr " + p + "\n"
    pack := "  " + v + " = insertvalue {i64, ptr} undef, i64 " + lns + ", 0\n" +
      "  " + v2 + " = insertvalue {i64, ptr} " + v + ", ptr " + p + ", 1\n"
    (head + store + pack, v2, "true", "str", c + 3)
  } :
  node.0 == "name" ? {
    reg := `%t{c}`
    ty := lookup_type(env, node.1)
    ("  " + reg + " = load " + lltype(ty) + ", ptr " + lookup(env, node.1) + "\n", reg, "true", ty, c + 1)
  } :
  node.0 == "tuple" ? {                                 // (a, b, ...) -> aggregate
    eir, ops, tys, c1 := gen_elems(node.1, env, c)
    tty := ("tup", tys)
    llt := lltype(tty)
    acc: &str := "undef"
    body: &str := eir
    cc:  &int := c1
    ops @ (i: op => {
      reg := `%t{cc}`
      body = body + "  " + reg + " = insertvalue " + llt + " " + acc + ", " +
        lltype(tys[i]) + " " + op + ", " + `{i}` + "\n"
      acc = reg
      cc = cc + 1
      ()
    })
    (body, acc, "true", tty, cc)
  } :
  node.0 == "list" ? {                                 // [e0, e1, ...] -> fat {len, ptr}
    node.1.len == 0 ? {                                // empty: {0, null}
      r0 := `%t{c}`
      r1 := `%t{c + 1}`
      ("  " + r0 + " = insertvalue {i64, ptr} undef, i64 0, 0\n" +
       "  " + r1 + " = insertvalue {i64, ptr} " + r0 + ", ptr null, 1\n",
       r1, "true", ("lst", "i64"), c + 2)
    } :
    {
      eir, ops, tys, c1 := gen_elems(node.1, env, c)
      et  := tys[0]
      etl := lltype(et)
      n   := `{node.1.len}`
      endp := `%t{c1}`
      bytes := `%t{c1 + 1}`
      base := `%t{c1 + 2}`
      body: &str := eir +
        "  " + endp + " = getelementptr " + etl + ", ptr null, i64 " + n + "\n" +
        "  " + bytes + " = ptrtoint ptr " + endp + " to i64\n" +
        "  " + base + " = call ptr @__alloc(i64 " + bytes + ")\n"
      cc: &int := c1 + 3
      ops @ (i: op => {
        ep := `%t{cc}`
        body = body + "  " + ep + " = getelementptr " + etl + ", ptr " + base + ", i64 " + `{i}` + "\n" +
          "  store " + etl + " " + op + ", ptr " + ep + "\n"
        cc = cc + 1
        ()
      })
      v0 := `%t{cc}`
      v1 := `%t{cc + 1}`
      body = body + "  " + v0 + " = insertvalue {i64, ptr} undef, i64 " + n + ", 0\n" +
        "  " + v1 + " = insertvalue {i64, ptr} " + v0 + ", ptr " + base + ", 1\n"
      (body, v1, "true", ("lst", et), cc + 2)
    }
  } :
  node.0 == "member" ? {
    oir, ov, of, ot, c1 := gen_expr(node.1, env, c)
    reg := `%t{c1}`
    node.2 == "len" ?                                   // str/list length field 0
      (oir + "  " + reg + " = extractvalue {i64, ptr} " + ov + ", 0\n", reg, "true", "i64", c1 + 1) :
      {                                                 // numeric tuple field .N
        fty := tup_field(ot, fieldnum(node.2))
        (oir + "  " + reg + " = extractvalue " + lltype(ot) + " " + ov + ", " + node.2 + "\n",
         reg, "true", fty, c1 + 1)
      }
  } :
  node.0 == "index" ? {                                 // obj[i]
    oir, ov, of, ot, c1 := gen_expr(node.1, env, c)
    iir, iv, iff, it, c2 := gen_expr(node.2, env, c1)
    ot == "str" ? {                                     // s[i] -> shared 1-char str
      bp := `%t{c2}`
      elt := `%t{c2 + 1}`
      v0 := `%t{c2 + 2}`
      v1 := `%t{c2 + 3}`
      (oir + iir +
       "  " + bp + " = extractvalue {i64, ptr} " + ov + ", 1\n" +
       "  " + elt + " = getelementptr i8, ptr " + bp + ", i64 " + iv + "\n" +
       "  " + v0 + " = insertvalue {i64, ptr} undef, i64 1, 0\n" +
       "  " + v1 + " = insertvalue {i64, ptr} " + v0 + ", ptr " + elt + ", 1\n",
       v1, "true", "str", c2 + 4)
    } :
    {                                                  // xs[i] -> element via typed gep
      et  := elemtype(ot)
      etl := lltype(et)
      bp  := `%t{c2}`
      ep  := `%t{c2 + 1}`
      elt := `%t{c2 + 2}`
      (oir + iir +
       "  " + bp + " = extractvalue {i64, ptr} " + ov + ", 1\n" +
       "  " + ep + " = getelementptr " + etl + ", ptr " + bp + ", i64 " + iv + "\n" +
       "  " + elt + " = load " + etl + ", ptr " + ep + "\n",
       elt, "true", et, c2 + 3)
    }
  } :
  node.0 == "call" ? {
    air, ops, c2 := gen_args(node.2, env, c)
    rt := (lookup_type(env, node.1)).1                 // ("fn", rettype) -> rettype
    reg := `%t{c2}`
    (air + "  " + reg + " = call " + lltype(rt) + " @" + node.1 + "(" + ops + ")\n",
     reg, "true", rt, c2 + 1)
  } :
  node.0 == "if" ? {
    cir, tag, c1 := gen_cond(node.1, env, c)
    res := `%r{c1}`
    tir, tv, tf, tt, c3 := gen_expr(node.2, env, c1 + 1)
    eir, ev, ef, et, c4 := gen_expr(node.3, env, c3)
    rty := lltype(tt)
    L := `{c4}`                                       // shared label suffix
    body := cir + "  " + res + " = alloca " + rty + "\n" +
      "  br i1 " + tag + ", label %then" + L + ", label %else" + L + "\n" +
      "then" + L + ":\n" + tir + "  store " + rty + " " + tv + ", ptr " + res +
        "\n  br label %merge" + L + "\n" +
      "else" + L + ":\n" + eir + "  store " + rty + " " + ev + ", ptr " + res +
        "\n  br label %merge" + L + "\n" +
      "merge" + L + ":\n"
    reg := `%t{c4 + 1}`
    (body + "  " + reg + " = load " + rty + ", ptr " + res + "\n", reg, "true", tt, c4 + 2)
  } :
  node.0 == "try" ? {                                  // cond ? then -> present|()
    cir, tag, c1 := gen_cond(node.1, env, c)
    vp := `%rp{c1}`
    fp := `%rf{c1}`
    tir, tv, tf, tt, c3 := gen_expr(node.2, env, c1 + 1)
    rty  := lltype(tt)
    zero := zerov(tt)
    L := `{c3}`
    body := cir + "  " + vp + " = alloca " + rty + "\n  " + fp + " = alloca i1\n" +
      "  br i1 " + tag + ", label %some" + L + ", label %none" + L + "\n" +
      "some" + L + ":\n" + tir +
        "  store " + rty + " " + tv + ", ptr " + vp + "\n  store i1 " + tf + ", ptr " + fp +
        "\n  br label %end" + L + "\n" +
      "none" + L + ":\n  store " + rty + " " + zero + ", ptr " + vp + "\n  store i1 false, ptr " + fp +
        "\n  br label %end" + L + "\n" +
      "end" + L + ":\n"
    v := `%t{c3}`
    f := `%t{c3 + 1}`
    (body + "  " + v + " = load " + rty + ", ptr " + vp + "\n" +
            "  " + f + " = load i1, ptr " + fp + "\n", v, f, tt, c3 + 2)
  } :
  node.0 == "rel" ? {                                  // relation as a value -> 0/1
    la, lv, lf, lt, c1 := gen_expr(node.2, env, c)
    ra, rv, rf, rt, c2 := gen_expr(node.3, env, c1)
    lt == "str" ? {
      sc := `%t{c2}`
      cmp := `%t{c2 + 1}`
      reg := `%t{c2 + 2}`
      (la + ra + "  " + sc + " = call i64 @__strcmp({i64, ptr} " + lv + ", {i64, ptr} " + rv + ")\n" +
       "  " + cmp + " = icmp " + relpred(node.1) + " i64 " + sc + ", 0\n" +
       "  " + reg + " = zext i1 " + cmp + " to i64\n", reg, "true", "i64", c2 + 3)
    } :
    {
      cmp := `%t{c2}`
      reg := `%t{c2 + 1}`
      (la + ra + "  " + cmp + " = icmp " + relpred(node.1) + " i64 " + lv + ", " + rv + "\n" +
       "  " + reg + " = zext i1 " + cmp + " to i64\n", reg, "true", "i64", c2 + 2)
    }
  } :
  node.0 == "iter" ? {                                 // src @|# (name => body)
    src := node.2
    arm := node.3
    src.0 == "range" && arm.0 == "arm" ? {
      // a `..` range counts the element from lo to hi inclusive; the arm's
      // bound name IS the counter slot, so the body reads it like any local.
      lir, lov, lf, lt, c1 := gen_expr(src.1, env, c)
      hir, hiv, hf, ht, c2 := gen_expr(src.2, env, c1)
      L  := `{c2}`
      iv := `%iv{c2}`
      bir, be, c3, bop, bflag, bty := gen_stmt(arm.2, env + [(arm.1, iv, "i64")], c2 + 1)
      head := lir + hir +
        "  " + iv + " = alloca i64\n  store i64 " + lov + ", ptr " + iv + "\n" +
        "  br label %lc" + L + "\n" +
        "lc" + L + ":\n  %ic" + L + " = load i64, ptr " + iv + "\n" +
        "  %cm" + L + " = icmp sle i64 %ic" + L + ", " + hiv + "\n" +
        "  br i1 %cm" + L + ", label %lb" + L + ", label %le" + L + "\n" +
        "lb" + L + ":\n" + bir
      step := "  %in" + L + " = load i64, ptr " + iv + "\n  %nx" + L + " = add i64 %in" + L + ", 1\n" +
        "  store i64 %nx" + L + ", ptr " + iv + "\n  br label %lc" + L + "\n"
      bflag == "false" ? {
        (head + step + "le" + L + ":\n", "0", "false", "i64", c3)
      } :
      gen_find(head, step, L, bop, bflag, bty, c3)
    } :
    arm.0 == "arm" ? {                                   // src is a list expression
      sir, sv, sf, st, c1 := gen_expr(src, env, c)
      et  := elemtype(st)
      etl := lltype(et)
      L  := `{c1}`
      lp := `%lp{c1}`
      ln := `%ln{c1}`
      iv := `%iv{c1}`
      es := `%es{c1}`
      bir, be, c3, bop, bflag, bty := gen_stmt(arm.2, env + [(arm.1, es, et)], c1 + 1)
      head := sir +
        "  " + ln + " = extractvalue {i64, ptr} " + sv + ", 0\n" +
        "  " + lp + " = extractvalue {i64, ptr} " + sv + ", 1\n" +
        "  " + iv + " = alloca i64\n  store i64 0, ptr " + iv + "\n" +
        "  " + es + " = alloca " + etl + "\n" +
        "  br label %lc" + L + "\n" +
        "lc" + L + ":\n  %ic" + L + " = load i64, ptr " + iv + "\n" +
        "  %cm" + L + " = icmp slt i64 %ic" + L + ", " + ln + "\n" +
        "  br i1 %cm" + L + ", label %lb" + L + ", label %le" + L + "\n" +
        "lb" + L + ":\n" +
        "  %ep" + L + " = getelementptr " + etl + ", ptr " + lp + ", i64 %ic" + L + "\n" +
        "  %ev" + L + " = load " + etl + ", ptr %ep" + L + "\n" +
        "  store " + etl + " %ev" + L + ", ptr " + es + "\n" + bir
      step := "  %in" + L + " = load i64, ptr " + iv + "\n  %nx" + L + " = add i64 %in" + L + ", 1\n" +
        "  store i64 %nx" + L + ", ptr " + iv + "\n  br label %lc" + L + "\n"
      bflag == "false" ? {
        (head + step + "le" + L + ":\n", "0", "false", "i64", c3)
      } :
      gen_find(head, step, L, bop, bflag, bty, c3)
    } :
    ("", "0", "false", "i64", c)
  } :
  {                                                    // binary op
    la, lv, lf, lt, c1 := gen_expr(node.2, env, c)
    ra, rv, rf, rt, c2 := gen_expr(node.3, env, c1)
    lt == "str" && node.1 == "+" ? {                   // string concatenation
      al := `%t{c2}`
      ap := `%t{c2 + 1}`
      bl := `%t{c2 + 2}`
      bp := `%t{c2 + 3}`
      tot := `%t{c2 + 4}`
      np := `%t{c2 + 5}`
      dst := `%t{c2 + 6}`
      rv0 := `%t{c2 + 7}`
      rv1 := `%t{c2 + 8}`
      instr := la + ra +
        "  " + al + " = extractvalue {i64, ptr} " + lv + ", 0\n" +
        "  " + ap + " = extractvalue {i64, ptr} " + lv + ", 1\n" +
        "  " + bl + " = extractvalue {i64, ptr} " + rv + ", 0\n" +
        "  " + bp + " = extractvalue {i64, ptr} " + rv + ", 1\n" +
        "  " + tot + " = add i64 " + al + ", " + bl + "\n" +
        "  " + np + " = call ptr @__alloc(i64 " + tot + ")\n" +
        "  call void @llvm.memcpy.p0.p0.i64(ptr " + np + ", ptr " + ap + ", i64 " + al + ", i1 false)\n" +
        "  " + dst + " = getelementptr i8, ptr " + np + ", i64 " + al + "\n" +
        "  call void @llvm.memcpy.p0.p0.i64(ptr " + dst + ", ptr " + bp + ", i64 " + bl + ", i1 false)\n" +
        "  " + rv0 + " = insertvalue {i64, ptr} undef, i64 " + tot + ", 0\n" +
        "  " + rv1 + " = insertvalue {i64, ptr} " + rv0 + ", ptr " + np + ", 1\n"
      (instr, rv1, "true", "str", c2 + 9)
    } :
    lt != "i64" && lt != "str" && node.1 == "+" ? {     // list append: xs + ys
      et  := elemtype(lt)
      etl := lltype(et)
      instr := la + ra +
        "  %t" + `{c2}` + " = extractvalue {i64, ptr} " + lv + ", 0\n" +
        "  %t" + `{c2 + 1}` + " = extractvalue {i64, ptr} " + lv + ", 1\n" +
        "  %t" + `{c2 + 2}` + " = extractvalue {i64, ptr} " + rv + ", 0\n" +
        "  %t" + `{c2 + 3}` + " = extractvalue {i64, ptr} " + rv + ", 1\n" +
        "  %t" + `{c2 + 4}` + " = add i64 %t" + `{c2}` + ", %t" + `{c2 + 2}` + "\n" +
        "  %t" + `{c2 + 5}` + " = getelementptr " + etl + ", ptr null, i64 %t" + `{c2 + 4}` + "\n" +
        "  %t" + `{c2 + 6}` + " = ptrtoint ptr %t" + `{c2 + 5}` + " to i64\n" +
        "  %t" + `{c2 + 7}` + " = call ptr @__alloc(i64 %t" + `{c2 + 6}` + ")\n" +
        "  %t" + `{c2 + 8}` + " = getelementptr " + etl + ", ptr null, i64 %t" + `{c2}` + "\n" +
        "  %t" + `{c2 + 9}` + " = ptrtoint ptr %t" + `{c2 + 8}` + " to i64\n" +
        "  call void @llvm.memcpy.p0.p0.i64(ptr %t" + `{c2 + 7}` + ", ptr %t" + `{c2 + 1}` +
          ", i64 %t" + `{c2 + 9}` + ", i1 false)\n" +
        "  %t" + `{c2 + 10}` + " = getelementptr " + etl + ", ptr %t" + `{c2 + 7}` + ", i64 %t" + `{c2}` + "\n" +
        "  %t" + `{c2 + 11}` + " = getelementptr " + etl + ", ptr null, i64 %t" + `{c2 + 2}` + "\n" +
        "  %t" + `{c2 + 12}` + " = ptrtoint ptr %t" + `{c2 + 11}` + " to i64\n" +
        "  call void @llvm.memcpy.p0.p0.i64(ptr %t" + `{c2 + 10}` + ", ptr %t" + `{c2 + 3}` +
          ", i64 %t" + `{c2 + 12}` + ", i1 false)\n" +
        "  %t" + `{c2 + 13}` + " = insertvalue {i64, ptr} undef, i64 %t" + `{c2 + 4}` + ", 0\n" +
        "  %t" + `{c2 + 14}` + " = insertvalue {i64, ptr} %t" + `{c2 + 13}` + ", ptr %t" + `{c2 + 7}` + ", 1\n"
      (instr, "%t" + `{c2 + 14}`, "true", lt, c2 + 15)
    } :
    {
      reg := `%t{c2}`
      instr := la + ra + "  " + reg + " = " + llop(node.1) + " i64 " + lv + ", " + rv + "\n"
      (instr, reg, "true", "i64", c2 + 1)
    }
  }
}

// gen one statement -> (instructions, env', counter', value-op or "", flag, type).
// Stores/intros yield (), so their value-op is "" / flag "false"; a bare final
// expression carries its value, present-flag, AND type through (so `@` find can
// type its result slot).
gen_stmt := (s: (str, str), env: [(str, str)], c: int) -> (str, [(str, str)], int, str, str, str) {
  s.0 == "let" ? {
    i2, op, of, ot, c2 := gen_expr(s.2, env, c)
    rty := lltype(ot)
    slot := `%s{c2}`
    (i2 + "  " + slot + " = alloca " + rty + "\n  store " + rty + " " + op + ", ptr " + slot + "\n",
     env + [(s.1, slot, ot)], c2 + 1, "", "false", "i64")
  } :
  s.0 == "letty" ? {                                    // name: Type := expr (annotated)
    aty := s.2                                          // the declared type
    rty := lltype(aty)
    i2, op, of, ot, c2 := gen_expr(s.3, env, c)
    slot := `%s{c2}`
    (i2 + "  " + slot + " = alloca " + rty + "\n  store " + rty + " " + op + ", ptr " + slot + "\n",
     env + [(s.1, slot, aty)], c2 + 1, "", "false", "i64")
  } :
  s.0 == "destruct" ? {                                 // a, b, ... := tuple-expr
    ri, ro, rf, rt, c2 := gen_expr(s.2, env, c)
    ir: &str := ri
    e2: &[(str, str)] := env
    cc: &int := c2
    s.1 @ (i: nm => {
      fty := tup_field(rt, i)
      fll := lltype(fty)
      val  := `%t{cc}`
      slot := `%s{cc + 1}`
      ir = ir + "  " + val + " = extractvalue " + lltype(rt) + " " + ro + ", " + `{i}` + "\n" +
        "  " + slot + " = alloca " + fll + "\n  store " + fll + " " + val + ", ptr " + slot + "\n"
      e2 = e2 + [(nm, slot, fty)]
      cc = cc + 2
      ()
    })
    (ir, e2, cc, "", "false", "i64")
  } :
  s.0 == "store" ? {
    i2, op, of, ot, c2 := gen_expr(s.2, env, c)
    rty := lltype(lookup_type(env, s.1))
    (i2 + "  store " + rty + " " + op + ", ptr " + lookup(env, s.1) + "\n", env, c2, "", "false", "i64")
  } :
  s.0 == "inplace" ? {
    // x op= e  is  x = x op e; reuse gen_expr's typed binary by rewriting it.
    expanded := ("bin", iop(s.2), ("name", s.1), s.3)
    i2, op, of, ot, c2 := gen_expr(expanded, env, c)
    rty := lltype(lookup_type(env, s.1))
    (i2 + "  store " + rty + " " + op + ", ptr " + lookup(env, s.1) + "\n", env, c2, "", "false", "i64")
  } :
  { i2, op, of, ot, c2 := gen_expr(s.1, env, c); (i2, env, c2, op, of, ot) }
}

gen_body := (stmts: [(str, str)], env0: [(str, str)], c0: int, retll: str) -> str {
  ir:  &str := ""
  env: &[(str, str)] := env0
  c:   &int := c0
  ret: &str := retll == "i64" ? "0" : "zeroinitializer"
  stmts @ (s => {
    si, e2, c2, op, of, ot := gen_stmt(s, env, c)
    ir = ir + si
    env = e2
    c = c2
    op != "" ? { ret = op } : ()
    ()
  })
  ir + "  ret " + retll + " " + ret + "\n"
}

// ("fn", name, params, rettype, stmts) -> a complete `define`. ftab seeds the
// env with every top-level function's signature so calls resolve return types.
gen_fn := (fn: (str, str), ftab: [(str, str)]) -> str {
  name   := fn.1
  params := fn.2                                        // [(name, type)]
  rty    := fn.3
  stmts  := fn.4
  retll  := lltype(rty)
  sig:   &str := ""
  setup: &str := ""
  env0:  &[(str, str)] := ftab
  params @ (i: pr => {
    pty  := pr.1
    pll  := lltype(pty)
    pp   := `%a{i}`
    slot := `%a{i}_addr`
    sig   = sig + (i == 0 ? "" : ", ") + pll + " " + pp
    setup = setup + "  " + slot + " = alloca " + pll + "\n  store " + pll + " " + pp + ", ptr " + slot + "\n"
    env0  = env0 + [(pr.0, slot, pty)]
    ()
  })
  "define " + retll + " @" + name + "(" + sig + ") {\n" +
  "entry:\n" + setup + gen_body(stmts, env0, 0, retll) + "}\n"
}

// the module preamble: a static bump arena (allocate, never free until exit;
// zero syscalls for memory) and the one intrinsic we lean on for concat.
preamble := () -> str {
  "; gridc\n" +
  "@arena = global [16777216 x i8] zeroinitializer\n" +
  "@hp = global i64 0\n" +
  "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n" +
  "define ptr @__alloc(i64 %n) {\n" +
  "  %a = add i64 %n, 7\n  %r = and i64 %a, -8\n" +
  "  %h = load i64, ptr @hp\n" +
  "  %p = getelementptr [16777216 x i8], ptr @arena, i64 0, i64 %h\n" +
  "  %h2 = add i64 %h, %r\n  store i64 %h2, ptr @hp\n  ret ptr %p\n}\n" +
  // lexicographic compare of two fat strings -> negative / 0 / positive
  "define i64 @__strcmp({i64, ptr} %a, {i64, ptr} %b) {\n" +
  "entry:\n" +
  "  %alen = extractvalue {i64, ptr} %a, 0\n  %aptr = extractvalue {i64, ptr} %a, 1\n" +
  "  %blen = extractvalue {i64, ptr} %b, 0\n  %bptr = extractvalue {i64, ptr} %b, 1\n" +
  "  %alt = icmp slt i64 %alen, %blen\n  %min = select i1 %alt, i64 %alen, i64 %blen\n" +
  "  %ip = alloca i64\n  store i64 0, ptr %ip\n  br label %loop\n" +
  "loop:\n  %i = load i64, ptr %ip\n  %done = icmp sge i64 %i, %min\n" +
  "  br i1 %done, label %bylen, label %body\n" +
  "body:\n  %ap = getelementptr i8, ptr %aptr, i64 %i\n  %bp = getelementptr i8, ptr %bptr, i64 %i\n" +
  "  %ac = load i8, ptr %ap\n  %bc = load i8, ptr %bp\n  %ne = icmp ne i8 %ac, %bc\n" +
  "  br i1 %ne, label %diff, label %cont\n" +
  "cont:\n  %i2 = add i64 %i, 1\n  store i64 %i2, ptr %ip\n  br label %loop\n" +
  "diff:\n  %az = zext i8 %ac to i64\n  %bz = zext i8 %bc to i64\n  %d = sub i64 %az, %bz\n  ret i64 %d\n" +
  "bylen:\n  %ld = sub i64 %alen, %blen\n  ret i64 %ld\n}\n"
}

gen := (fns: [(str, str)]) -> str {
  ftab: &[(str, str)] := []                            // name -> (@name, ("fn", rettype))
  fns @ (f => { ftab = ftab + [(f.1, "@" + f.1, ("fn", f.3))]; () })
  out: &str := preamble()
  fns @ (f => { out = out + gen_fn(f, ftab); () })
  out
}

main := (args: [str]) -> int {
  src := fs.read(args[0])
  fs.write(args[1], gen(parse_program(lex(src))))
  0
}
