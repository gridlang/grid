// gridc — the Grid compiler, written in Grid (bootstrapped on gridi).
//
//   gridi gridc.grid  <source.grid>  <out.ll>
//
// Emits LLVM IR text; `clang out.ll -o bin` links a native binary.
//
// Rungs: C1 literal · C2 lexer · C3 parser · C4 arithmetic ·
//        C5a immutable locals · C5b mutable locals + stores · C5c functions + calls.
//
// Subset compiled: a program is one or more `name := (params) -> int { stmts }`
// functions over i64; stmts are lets / stores / in-place / a final result expr;
// exprs are integer arithmetic, locals, and calls. `main` is the entry point.
//
// Note: `?:` ladders put the `:` at the END of a line (a newline after `:`
// continues; a newline after `}` would end the statement).
module main

import fs
import sys

// ── lexer ────────────────────────────────────────────────────────────
digit := (c: str) -> str { c >= "0" && c <= "9" }
alpha := (c: str) -> str { (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_" }
alnum := (c: str) -> str { alpha(c) || digit(c) }      // identifier continuation
space := (c: str) -> str { c == " " || c == "\t" || c == "\r" }

// a line ending in one of these tokens continues onto the next (no statement
// break) — operators, ?:, comma, the arrows and assigns. Brackets are handled
// by paren-depth instead.
continues := (t: str) -> str {
  t == "+" || t == "-" || t == "*" || t == "/" || t == "%" ||
  t == "==" || t == "!=" || t == "<" || t == "<=" || t == ">" || t == ">=" ||
  t == "&&" || t == "||" || t == "?" || t == ":" || t == "," || t == ".." ||
  t == "->" || t == "=>" || t == ":=" || t == "=" ||
  t == "+=" || t == "-=" || t == "*=" || t == "/="
}

scan := (src: str, start: int, n: int, p: (str) -> str) -> (str, int) {
  text: &str := ""
  j: &int := start
  { j < n && p(src[j]) } @ { text = text + src[j]; j += 1; () }
  (text, j)
}

// read a "double-quoted" literal starting just past the opening quote; decode
// the common escapes and return (decoded-text, index just past the close quote).
scan_str := (src: str, start: int, n: int) -> (str, int) {
  text: &str := ""
  j: &int := start
  { j < n && src[j] != "\"" } @ {
    src[j] == "\\" && j + 1 < n ? {
      e := src[j + 1]
      text = text + (e == "n" ? "\n" : e == "t" ? "\t" : e == "r" ? "\r" : e)
      j += 2
    } :
    { text = text + src[j]; j += 1 }
    ()
  }
  (text, j + 1)
}

// read a `backtick` string's raw content (interpolations left intact) to the close.
scan_bq := (src: str, start: int, n: int) -> (str, int) {
  text: &str := ""
  j: &int := start
  { j < n && src[j] != "`" } @ { text = text + src[j]; j += 1; () }
  (text, j + 1)
}

lex := (src: str) -> [(str, str)] {
  toks: &[(str, str)] := []
  i: &int := 0
  depth: &int := 0                                     // ( / [ nesting
  last: &str := "nl"                                   // last emitted token
  n := src.len
  { i < n } @ {
    c := src[i]
    (c == "\n" || c == ";") ? {                        // statement break, unless continuing
      depth > 0 || continues(last) ? () :
        { toks = toks + [("nl", "nl")]; last = "nl" }
      i += 1
    } :
    space(c) ? { i += 1 } :
    digit(c) ? { t, j := scan(src, i, n, digit); toks = toks + [("int", t)]; last = "int"; i = j } :
    alpha(c) ? { t, j := scan(src, i, n, alnum); toks = toks + [("name", t)]; last = "name"; i = j } :
    c == "\"" ? { t, j := scan_str(src, i + 1, n); toks = toks + [("str", t)]; last = "str"; i = j } :
    c == "`" ? { t, j := scan_bq(src, i + 1, n); toks = toks + [("bq", t)]; last = "bq"; i = j } :
    {
      two := i + 1 < n ? src[i] + src[i + 1] : ""
      two == "//" ? { { i < n && src[i] != "\n" } @ { i += 1; () } } :
      (two == ":=" || two == "->" || two == "=>" || two == ".." ||
       two == "+=" || two == "-=" || two == "*=" || two == "/=" ||
       two == "==" || two == "!=" || two == "<=" || two == ">=" ||
       two == "&&" || two == "||") ? {
        toks = toks + [(two, two)]; last = two; i += 2
      } :
      {
        toks = toks + [(c, c)]
        last = c
        c == "(" || c == "[" ? { depth += 1 } : ()
        c == ")" || c == "]" ? { depth -= 1 } : ()
        i += 1
      }
    }
    ()
  }
  toks
}

// ── parser ───────────────────────────────────────────────────────────
// expr: ("int",v) ("name",x) ("bin",op,l,r) ("call",name,[args])
// stmt: ("let",n,e) ("store",n,e) ("inplace",n,op,e) ("ret",e)
// top:  ("fn", name, [params], [stmts])

tkind := (toks: [(str, str)], pos: int) -> str { pos < toks.len ? toks[pos].0 : "eof" }
ttext := (toks: [(str, str)], pos: int) -> str { toks[pos].1 }

mulop := (k: str) -> str { k == "*" || k == "/" || k == "%" }
addop := (k: str) -> str { k == "+" || k == "-" }
cmpop := (k: str) -> str { k == "==" || k == "!=" || k == "<" || k == "<=" || k == ">" || k == ">=" }
boolop := (k: str) -> str { k == "&&" || k == "||" }
inplaceop := (k: str) -> str { k == "+=" || k == "-=" || k == "*=" || k == "/=" }

parse_args := (toks: [(str, str)], pos: int) -> ([(str, str)], int) {
  args: &[(str, str)] := []
  cur: &int := pos
  { tkind(toks, cur) != ")" && tkind(toks, cur) != "eof" } @ {
    node, p := parse_expr(toks, cur)
    args = args + [node]
    cur = tkind(toks, p) == "," ? p + 1 : p
    ()
  }
  (args, cur + 1)
}

// a `backtick` interpolation -> a + -tree of ("str", lit) parts and __itoa(expr)
// calls, so codegen reuses string concat and the call path (no new node kind).
parse_interp := (raw: str) -> (str, str) {
  parts: &[(str, str)] := []
  lit:   &str := ""
  i:     &int := 0
  n := raw.len
  { i < n } @ {
    raw[i] == "{" ? {
      lit.len > 0 ? { parts = parts + [("str", lit)] }
      lit = ""
      e: &str := ""
      i += 1
      { i < n && raw[i] != "}" } @ { e = e + raw[i]; i += 1; () }
      i += 1
      enode, ep := parse_expr(lex(e), 0)
      parts = parts + [("call", "__itoa", [enode])]
    } :
    { lit = lit + raw[i]; i += 1 }
    ()
  }
  lit.len > 0 ? { parts = parts + [("str", lit)] }
  parts.len == 0 ? ("str", "") :
  {
    acc: &(str, str) := parts[0]
    k:   &int := 1
    { k < parts.len } @ { acc = ("bin", "+", acc, parts[k]); k += 1; () }
    acc
  }
}

parse_atom := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  k := tkind(toks, pos)
  k == "int" ? (("int", ttext(toks, pos)), pos + 1) :
  k == "str" ? (("str", ttext(toks, pos)), pos + 1) :
  k == "bq"  ? (parse_interp(ttext(toks, pos)), pos + 1) :
  k == "name" ? {
    tkind(toks, pos + 1) == "(" ? {
      args, p := parse_args(toks, pos + 2)
      (("call", ttext(toks, pos), args), p)
    } :
    (("name", ttext(toks, pos)), pos + 1)
  } :
  k == "{" ? {                                         // { stmts } block expression
    stmts, p := parse_body(toks, pos + 1)
    (("block", stmts), p + 1)
  } :
  k == "[" ? {
    tkind(toks, pos + 1) == "]" ? (("list", []), pos + 2) :   // empty list
    {
      elems: &[(str, str)] := []
      cur: &int := pos + 1
      { tkind(toks, cur) != "]" && tkind(toks, cur) != "eof" } @ {
        e, p := parse_expr(toks, cur)
        elems = elems + [e]
        cur = tkind(toks, p) == "," ? p + 1 : p
        ()
      }
      (("list", elems), cur + 1)
    }
  } :
  k == "(" ? {
    tkind(toks, pos + 1) == ")" ? (("unit", ""), pos + 2) :   // () the unit value
    {
    first, p := parse_expr(toks, pos + 1)
    tkind(toks, p) == "," ? {                          // (a, b, ...) tuple
      elems: &[(str, str)] := [first]
      cur: &int := p
      { tkind(toks, cur) == "," } @ {
        e, p2 := parse_expr(toks, cur + 1)
        elems = elems + [e]
        cur = p2
        ()
      }
      (("tuple", elems), cur + 1)
    } :
    (first, p + 1)                                      // plain (expr)
    }
  } :
  (("int", "0"), pos + 1)
}

// postfix chain: atom ( .member | [index] )*
parse_postfix := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  node, p := parse_atom(toks, pos)
  acc: &(str, str) := node
  cur: &int := p
  { tkind(toks, cur) == "." || tkind(toks, cur) == "[" } @ {
    tkind(toks, cur) == "." ? {
      tkind(toks, cur + 2) == "(" ? {                  // obj.method(args) -> qualified call
        args, p2 := parse_args(toks, cur + 3)
        acc = ("call", acc.1 + "." + ttext(toks, cur + 1), args)
        cur = p2
      } :
      {
        acc = ("member", acc, ttext(toks, cur + 1))
        cur = cur + 2
      }
    } :
    {
      idx, p2 := parse_expr(toks, cur + 1)
      acc = ("index", acc, idx)
      cur = p2 + 1                                      // skip ]
    }
    ()
  }
  (acc, cur)
}

parse_mul := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  node, p := parse_postfix(toks, pos)
  acc: &(str, str) := node
  cur: &int := p
  { mulop(tkind(toks, cur)) } @ {
    op := ttext(toks, cur)
    rhs, p2 := parse_postfix(toks, cur + 1)
    acc = ("bin", op, acc, rhs)
    cur = p2
    ()
  }
  (acc, cur)
}

parse_add := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  node, p := parse_mul(toks, pos)
  acc: &(str, str) := node
  cur: &int := p
  { addop(tkind(toks, cur)) } @ {
    op := ttext(toks, cur)
    rhs, p2 := parse_mul(toks, cur + 1)
    acc = ("bin", op, acc, rhs)
    cur = p2
    ()
  }
  (acc, cur)
}

// range: a .. b  ->  ("range", a, b)
parse_range := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  l, p := parse_add(toks, pos)
  tkind(toks, p) == ".." ? {
    r, p2 := parse_add(toks, p + 1); (("range", l, r), p2)
  } :
  (l, p)
}

// a single relation (no chaining yet): ("rel", op, l, r)
parse_cmp := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  l, p := parse_range(toks, pos)
  cmpop(tkind(toks, p)) ? {
    r, p2 := parse_range(toks, p + 1); (("rel", ttext(toks, p), l, r), p2)
  } :
  (l, p)
}

// boolean selectors && / || , looser than comparison
parse_bool := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  l, p := parse_cmp(toks, pos)
  acc: &(str, str) := l
  cur: &int := p
  { boolop(tkind(toks, cur)) } @ {
    op := ttext(toks, cur)
    r, p2 := parse_cmp(toks, cur + 1)
    acc = ("bin", op, acc, r)
    cur = p2
    ()
  }
  (acc, cur)
}

// the combinators: source @ body / source # body -> ("iter", op, source, body)
parse_comb := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  l, p := parse_bool(toks, pos)
  acc: &(str, str) := l
  cur: &int := p
  { tkind(toks, cur) == "@" || tkind(toks, cur) == "#" } @ {
    op := ttext(toks, cur)
    body, p2 := parse_armbody(toks, cur + 1)
    acc = ("iter", op, acc, body)
    cur = p2
    ()
  }
  (acc, cur)
}

// a combinator body. Forms (all wrapped in ( … )):
//   ( name => stmt )          -> ("arm", name, stmt)
//   ( i: name => stmt )       -> ("armidx", idxname, name, stmt)
//   ( (a, b, …) => stmt )     -> ("armtup", [names], stmt)
//   ( expr )                  -> expr
parse_armbody := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  k1 := tkind(toks, pos + 1)
  tkind(toks, pos) == "(" && k1 == "name" && tkind(toks, pos + 2) == "=>" ? {
    s, p := parse_stmt(toks, pos + 3); (("arm", ttext(toks, pos + 1), s), p + 1)
  } :
  tkind(toks, pos) == "(" && k1 == "name" && tkind(toks, pos + 2) == ":" && tkind(toks, pos + 4) == "=>" ? {
    s, p := parse_stmt(toks, pos + 5); (("armidx", ttext(toks, pos + 1), ttext(toks, pos + 3), s), p + 1)
  } :
  tkind(toks, pos) == "(" && k1 == "(" ? {
    names: &[str] := []
    cur: &int := pos + 2
    { tkind(toks, cur) == "name" } @ {
      names = names + [ttext(toks, cur)]
      cur = tkind(toks, cur + 1) == "," ? cur + 2 : cur + 1
      ()
    }
    s, p := parse_stmt(toks, cur + 2)                   // skip ) and =>
    (("armtup", names, s), p + 1)
  } :
  { node, p := parse_expr(toks, pos); (node, p) }       // a { block } or ( expr ) body
}

// does the brace at `pos` open a match block (a top-level `=>` arm) rather than a
// plain `{ stmts }` body? Scan to the matching close, tracking bracket depth; a
// `=>` at depth 1 (directly inside the block, not in a nested `(...)`) means match.
is_match_block := (toks: [(str, str)], pos: int) -> int {
  depth: &int := 0
  cur:   &int := pos
  found: &int := 0
  done:  &int := 0
  { tkind(toks, cur) != "eof" && done == 0 } @ {
    k := tkind(toks, cur)
    (k == "{" || k == "(" || k == "[") ? { depth += 1 } :
    (k == "}" || k == ")" || k == "]") ? {
      depth -= 1
      depth == 0 ? { done = 1 } : ()
    } :
    (k == "=>" && depth == 1) ? { found = 1 } : ()
    cur += 1
    ()
  }
  found
}

// a match pattern: `_` (wildcard), `Case(b0, b1, …)` (ctor with bindings, `_` to
// skip a field), or a bare `Case` (nullary). -> ("pwild","_") | ("pctor",name,[binds]).
parse_pattern := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  nm := ttext(toks, pos)
  nm == "_" ? (("pwild", "_"), pos + 1) :
  tkind(toks, pos + 1) == "(" ? {
    binds: &[str] := []
    cur:   &int := pos + 2
    { tkind(toks, cur) != ")" && tkind(toks, cur) != "eof" } @ {
      binds = binds + [ttext(toks, cur)]
      cur = tkind(toks, cur + 1) == "," ? cur + 2 : cur + 1
      ()
    }
    (("pctor", nm, binds), cur + 1)
  } :
  (("pctor", nm, []), pos + 1)
}

// the arms of a match block: `pat => result` lines until the closing `}`.
// -> [("marm", pattern, result-stmt)], index just past `}`.
parse_arms := (toks: [(str, str)], pos: int) -> ([(str, str)], int) {
  arms: &[(str, str)] := []
  cur:  &int := skip_nl(toks, pos + 1)                  // skip `{` and any newlines
  { tkind(toks, cur) != "}" && tkind(toks, cur) != "eof" } @ {
    pat, p1 := parse_pattern(toks, cur)
    res, p2 := parse_stmt(toks, p1 + 1)                 // skip `=>`
    arms = arms + [("marm", pat, res)]
    cur = skip_nl(toks, p2)
    ()
  }
  (arms, cur + 1)
}

// cond ? then : else  ->  ("if", cond, then, else)   (loosest, right-assoc)
// cond ? then         ->  ("try", cond, then)        (one-armed: present or ())
// subj ? { pat => res … } -> ("match", subj, arms)   (variant tag dispatch)
parse_ternary := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  cond, p := parse_comb(toks, pos)
  tkind(toks, p) == "?" ? {
    tkind(toks, p + 1) == "{" && is_match_block(toks, p + 1) == 1 ? {
      arms, p2 := parse_arms(toks, p + 1)
      (("match", cond, arms), p2)
    } :
    {
      then, p2 := parse_expr(toks, p + 1)
      tkind(toks, p2) == ":" ? {
        els, p3 := parse_expr(toks, p2 + 1); (("if", cond, then, els), p3)
      } :
      (("try", cond, then), p2)
    }
  } :
  (cond, p)
}

parse_expr := (toks: [(str, str)], pos: int) -> ((str, str), int) { parse_ternary(toks, pos) }

skip_nl := (toks: [(str, str)], pos: int) -> int {
  cur: &int := pos
  { tkind(toks, cur) == "nl" } @ { cur += 1; () }
  cur
}

// skip a type annotation `: ... :=`, returning the index just past `:=`.
skip_type := (toks: [(str, str)], pos: int) -> int {
  cur: &int := pos
  { tkind(toks, cur) != ":=" && tkind(toks, cur) != "eof" } @ { cur += 1; () }
  cur + 1
}

parse_stmt := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  k0 := tkind(toks, pos)
  k1 := tkind(toks, pos + 1)
  k0 == "name" && k1 == "," ? {                        // a, b, ... := tuple-expr
    names: &[str] := [ttext(toks, pos)]
    cur: &int := pos + 1
    { tkind(toks, cur) == "," } @ {
      names = names + [ttext(toks, cur + 1)]
      cur = cur + 2
      ()
    }
    node, p := parse_expr(toks, cur + 1)               // cur is at :=
    (("destruct", names, node), p)
  } :
  k0 == "name" && k1 == ":=" ? {
    node, p := parse_expr(toks, pos + 2); (("let", ttext(toks, pos), node), p)
  } :
  k0 == "name" && k1 == ":" ? {                        // name: Type := expr
    ty, tp := parse_type(toks, pos + 2)                // tp lands on :=
    node, p := parse_expr(toks, tp + 1)
    (("letty", ttext(toks, pos), ty, node), p)
  } :
  k0 == "name" && k1 == "=" ? {
    node, p := parse_expr(toks, pos + 2); (("store", ttext(toks, pos), node), p)
  } :
  k0 == "name" && inplaceop(k1) ? {
    node, p := parse_expr(toks, pos + 2); (("inplace", ttext(toks, pos), k1, node), p)
  } :
  { node, p := parse_expr(toks, pos); (("ret", node), p) }
}

parse_body := (toks: [(str, str)], pos: int) -> ([(str, str)], int) {
  stmts: &[(str, str)] := []
  cur: &int := skip_nl(toks, pos)
  { tkind(toks, cur) != "}" && tkind(toks, cur) != "eof" } @ {
    s, p := parse_stmt(toks, cur)
    stmts = stmts + [s]
    cur = skip_nl(toks, p)
    ()
  }
  (stmts, cur)
}

// a capitalized leading letter marks a type / variant-case name (vs a builtin
// like `int` / `str` or a lowercase binding). Returns present/() like a predicate.
is_typename := (nm: str) -> str { nm[0] >= "A" && nm[0] <= "Z" }

// a type annotation -> a structured type (scalar string / ("tup",[..]) /
// ("lst",elem) / ("fn",ret) / ("var",name)). Storage capabilities (&/*) and
// fallible error channels (! E) don't affect the value rep, so they're stripped.
parse_type := (toks: [(str, str)], pos: int) -> (str, int) {
  k := tkind(toks, pos)
  (k == "&" || k == "*") ? parse_type(toks, pos + 1) :
  k == "[" ? {
    el, p := parse_type(toks, pos + 1)                // [ elem ]
    parse_type_suffix(toks, p + 1, ("lst", el))
  } :
  k == "(" ? {
    tkind(toks, pos + 1) == ")" ? {                   // () or () -> R
      tkind(toks, pos + 2) == "->" ? {
        r, p := parse_type(toks, pos + 3); (("fn", r), p)
      } :
      ("i64", pos + 2)
    } :
    {
      tys: &[str] := []
      cur: &int := pos + 1
      { tkind(toks, cur) != ")" && tkind(toks, cur) != "eof" } @ {
        t, p := parse_type(toks, cur)
        tys = tys + [t]
        cur = tkind(toks, p) == "," ? p + 1 : p
        ()
      }
      after := cur + 1                                 // past )
      tkind(toks, after) == "->" ? {                   // (params) -> R  function type
        r, p := parse_type(toks, after + 1); (("fn", r), p)
      } :
      tys.len == 1 ? parse_type_suffix(toks, after, tys[0]) :
      parse_type_suffix(toks, after, ("tup", tys))
    }
  } :
  k == "name" ? {
    nm := ttext(toks, pos)                              // int + all sized ints -> i64;
    base := nm == "str" ? "str" :                       // a capitalized name -> a variant
      is_typename(nm) ? ("var", nm) : "i64"
    parse_type_suffix(toks, pos + 1, base)
  } :
  ("i64", pos + 1)
}

// after a base type: an optional `! ErrType` fallible channel (error ignored).
parse_type_suffix := (toks: [(str, str)], pos: int, base: str) -> (str, int) {
  tkind(toks, pos) == "!" ? { e, p := parse_type(toks, pos + 1); (base, p) } :
  (base, pos)
}

// params -> [(name, type)], stopping just past the closing ')'.
parse_params := (toks: [(str, str)], pos: int) -> ([str], int) {
  ps: &[(str, str)] := []
  cur: &int := pos
  { tkind(toks, cur) != ")" && tkind(toks, cur) != "eof" } @ {
    nm := ttext(toks, cur)
    ty, p := tkind(toks, cur + 1) == ":" ? parse_type(toks, cur + 2) : ("i64", cur + 1)
    ps = ps + [(nm, ty)]
    cur = tkind(toks, p) == "," ? p + 1 : p
    ()
  }
  (ps, cur + 1)
}

// name := ( params ) -> rettype { stmts }
parse_fn := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  name := ttext(toks, pos)
  params, p1 := parse_params(toks, pos + 3)        // skip name := (
  rty, p2 := tkind(toks, p1) == "->" ? parse_type(toks, p1 + 1) : ("i64", p1)
  b: &int := p2
  { tkind(toks, b) != "{" && tkind(toks, b) != "eof" } @ { b += 1; () }
  stmts, p3 := parse_body(toks, b + 1)
  (("fn", name, params, rty, stmts), p3 + 1)
}

// Name := | Case0 T.. | Case1 T.. | …   ->   ("variant", name, [("case", cname, [fieldtypes])]).
// each case's fields are space-separated type atoms; cases may span lines (a leading
// `|` after a newline continues the declaration). The leading `|` distinguishes this
// from `x := a | b` (bitwise-or), so parse_program peeks for `:=` `|` before calling.
parse_variant := (toks: [(str, str)], pos: int) -> ((str, str), int) {
  name := ttext(toks, pos)
  cases: &[(str, str)] := []
  cur:   &int := pos + 2                            // skip name :=
  { tkind(toks, cur) == "|" } @ {
    cname := ttext(toks, cur + 1)
    fields: &[str] := []
    fc:     &int := cur + 2
    { tkind(toks, fc) != "|" && tkind(toks, fc) != "nl" && tkind(toks, fc) != "eof" } @ {
      ft, p := parse_type(toks, fc)
      fields = fields + [ft]
      fc = p
      ()
    }
    cases = cases + [("case", cname, fields)]
    cur = skip_nl(toks, fc)                         // a `|` after newline -> another case
    ()
  }
  (("variant", name, cases), cur)
}

parse_program := (toks: [(str, str)]) -> [(str, str)] {
  fns: &[(str, str)] := []
  cur: &int := skip_nl(toks, 0)
  { tkind(toks, cur) != "eof" } @ {
    // skip module / import header lines (not functions)
    tkind(toks, cur) == "name" && (ttext(toks, cur) == "module" || ttext(toks, cur) == "import") ? {
      { tkind(toks, cur) != "nl" && tkind(toks, cur) != "eof" } @ { cur += 1; () }
      cur = skip_nl(toks, cur)
    } :
    tkind(toks, cur) == "name" && tkind(toks, cur + 1) == ":=" && tkind(toks, cur + 2) == "|" ? {
      v, p := parse_variant(toks, cur)               // a sum-type declaration
      fns = fns + [v]
      cur = skip_nl(toks, p)
    } :
    {
      f, p := parse_fn(toks, cur)
      fns = fns + [f]
      cur = skip_nl(toks, p)
    }
    ()
  }
  fns
}

// ── codegen ──────────────────────────────────────────────────────────
llop := (op: str) -> str {
  op == "+" ? "add" : op == "-" ? "sub" : op == "*" ? "mul" : op == "/" ? "sdiv" :
  op == "&&" ? "and" : op == "||" ? "or" : "srem"
}
iop := (k: str) -> str { k == "+=" ? "+" : k == "-=" ? "-" : k == "*=" ? "*" : "/" }
relpred := (op: str) -> str {
  op == "==" ? "eq" : op == "!=" ? "ne" : op == "<" ? "slt" :
  op == "<=" ? "sle" : op == ">" ? "sgt" : "sge"
}

// env entries are (name, slot-ptr, type); look up the slot or the type by name.
lookup := (env: [(str, str)], name: str) -> str { env @ ((n, s, t) => n == name ? s) }
lookup_type := (env: [(str, str)], name: str) -> str { env @ ((n, s, t) => n == name ? t) }

// render a decoded string for an LLVM c"..." literal: escape ", \, and the
// control bytes as \NN (their byte length stays 1, matching the array type).
escape_ll := (s: str) -> str {
  out: &str := ""
  i: &int := 0
  m := s.len
  { i < m } @ {
    c := s[i]
    out = out +
      (c == "\"" ? "\\22" :
       c == "\\" ? "\\5C" :
       c == "\n" ? "\\0A" :
       c == "\t" ? "\\09" :
       c == "\r" ? "\\0D" : c)
    i += 1
    ()
  }
  out
}

// ── types ────────────────────────────────────────────────────────────
// A type is either a scalar string ("i64" | "str") or a compound tuple:
// ("tup", [fieldtypes]) for tuples, ("lst", elemtype) for lists. Both str
// and list lower to the fat value {i64, ptr}; a tuple to a flat LLVM struct.
fieldnum := (s: str) -> int {
  s == "0" ? 0 : s == "1" ? 1 : s == "2" ? 2 : s == "3" ? 3 :
  s == "4" ? 4 : s == "5" ? 5 : s == "6" ? 6 : 7
}

lltype := (t: str) -> str {
  t == "i64" ? "i64" :
  t == "str" ? "{i64, ptr}" :
  t.0 == "lst" ? "{i64, i64, ptr}" :                    // {len, cap, ptr} — growable
  t.0 == "fn" ? "ptr" :                                 // a function value is a code pointer
  t.0 == "var" ? "{i64, ptr}" :                         // variant: {tag, payload ptr}
  "{" + tup_ll(t.1) + "}"
}

is_fn := (t: str) -> str { t != "i64" && t != "str" && t.0 == "fn" }
is_list := (t: str) -> str { t != "i64" && t != "str" && t.0 == "lst" }
is_var := (t: str) -> str { t != "i64" && t != "str" && t.0 == "var" }
// a constructor marker ("ctor", tag, typename, [fieldtypes]) lives in the env.
is_ctor := (t: str) -> str { t != "i64" && t != "str" && t.0 == "ctor" }

tup_ll := (fields: [str]) -> str {
  out: &str := ""
  fields @ (i: f => { out = out + (i == 0 ? "" : ", ") + lltype(f); () })
  out
}

tup_field := (t: str, i: int) -> str { t.1[i] }
elemtype := (t: str) -> str { t.1 }                  // ("lst", elem) -> elem

// the zero / () value of a type, for store into a freshly-allocated slot.
zerov := (t: str) -> str { t == "i64" ? "0" : "zeroinitializer" }

// presence test of a value -> (instructions, i1 tag, counter). An i64 is present
// when nonzero; a fat str/list when its pointer is non-null ( () is {0, null} ).
gen_present := (v: str, vt: str, c: int) -> (str, str, int) {
  vt == "i64" ? {
    tag := `%t{c}`
    ("  " + tag + " = icmp ne i64 " + v + ", 0\n", tag, c + 1)
  } :
  is_var(vt) ? ("", "true", c) :                        // a constructed variant is always present
  {
    fld := vt == "str" ? "1" : "2"                      // str {len,ptr} / list {len,cap,ptr}
    p := `%t{c}`
    tag := `%t{c + 1}`
    ("  " + p + " = extractvalue " + lltype(vt) + " " + v + ", " + fld + "\n" +
     "  " + tag + " = icmp ne ptr " + p + ", null\n", tag, c + 2)
  }
}

// gen a condition -> (instructions, i1 tag, counter). A relation compares; a
// && / || combines its operands' presence; any other value tests presence.
gen_cond := (node: (str, str), env: [(str, str)], c: int) -> (str, str, int) {
  node.0 == "rel" ? {
    la, lv, lf, lt, c1 := gen_expr(node.2, env, c)
    ra, rv, rf, rt, c2 := gen_expr(node.3, env, c1)
    lt == "str" ? {                                    // compare via __strcmp
      sc := `%t{c2}`
      tag := `%t{c2 + 1}`
      (la + ra + "  " + sc + " = call i64 @__strcmp({i64, ptr} " + lv + ", {i64, ptr} " + rv + ")\n" +
       "  " + tag + " = icmp " + relpred(node.1) + " i64 " + sc + ", 0\n", tag, c2 + 2)
    } :
    {
      tag := `%t{c2}`
      (la + ra + "  " + tag + " = icmp " + relpred(node.1) + " i64 " + lv + ", " + rv + "\n",
       tag, c2 + 1)
    }
  } :
  node.0 == "bin" && boolop(node.1) ? {                // && / || over conditions
    la, ta, c1 := gen_cond(node.2, env, c)
    lb, tb, c2 := gen_cond(node.3, env, c1)
    tag := `%t{c2}`
    op := node.1 == "&&" ? "and" : "or"
    (la + lb + "  " + tag + " = " + op + " i1 " + ta + ", " + tb + "\n", tag, c2 + 1)
  } :
  { e, v, vf, vt, c1 := gen_expr(node, env, c)         // any other value: present?
    pir, tag, c2 := gen_present(v, vt, c1)
    (e + pir, tag, c2) }
}

// gen each call argument, returning (instructions, "i64 a, i64 b", counter).
gen_args := (args: [(str, str)], env: [(str, str)], c0: int) -> (str, str, int) {
  ir:  &str := ""
  ops: &str := ""
  c:   &int := c0
  args @ (i: a => {
    a2, op, af, at, c2 := gen_expr(a, env, c)
    ir = ir + a2
    ops = ops + (i == 0 ? "" : ", ") + lltype(at) + " " + op
    c = c2
    ()
  })
  (ir, ops, c)
}

// gen a sequence of expressions -> (instructions, [operands], [types], counter).
gen_elems := (elems: [(str, str)], env: [(str, str)], c0: int) -> (str, [str], [str], int) {
  ir:  &str := ""
  ops: &[str] := []
  tys: &[str] := []
  c:   &int := c0
  elems @ (e => {
    ei, eo, ef, et, c2 := gen_expr(e, env, c)
    ir  = ir + ei
    ops = ops + [eo]
    tys = tys + [et]
    c   = c2
    ()
  })
  (ir, ops, tys, c)
}

// the first-success ("find") tail shared by range and list `@`: given the loop
// `head` (ending in the body + its present-flag), the `step` that advances and
// re-loops, and the arm's payload (bop : bty), stop at the first present result
// and carry (payload, flag) out. -> (ir, value, flag, type, counter).
gen_find := (head: str, step: str, L: str, bop: str, bflag: str, bty: str, c: int) -> (str, str, str, str, int) {
  rty := lltype(bty)
  z   := zerov(bty)
  vp := "%fp" + L
  fp := "%ff" + L
  v  := "%fv" + L
  f  := "%fg" + L
  loop := "  " + vp + " = alloca " + rty + "\n  store " + rty + " " + z + ", ptr " + vp + "\n" +
    "  " + fp + " = alloca i1\n  store i1 false, ptr " + fp + "\n" +
    head +
    "  br i1 " + bflag + ", label %hit" + L + ", label %cont" + L + "\n" +
    "hit" + L + ":\n  store " + rty + " " + bop + ", ptr " + vp +
      "\n  store i1 true, ptr " + fp + "\n  br label %le" + L + "\n" +
    "cont" + L + ":\n" + step +
    "le" + L + ":\n  " + v + " = load " + rty + ", ptr " + vp +
      "\n  " + f + " = load i1, ptr " + fp + "\n"
  (loop, v, f, bty, c)
}

// bind an arm's pattern over the element slot `es` (type et), with the loop
// index available as `idxop` in the body. -> (env', preheader-ir, body-ir, stmt, counter).
// Field slots are GEPs into es (computed once in the preheader, since es is
// stable) and the index is one preheader-allocated slot stored each iteration —
// so nothing is allocated inside the loop body.
bind_arm := (arm: (str, str), es: str, et: str, idxop: str, env: [(str, str)], c: int) -> ([(str, str)], str, str, (str, str), int) {
  arm.0 == "armidx" ? {
    is := `%is{c}`
    (env + [(arm.1, is, "i64"), (arm.2, es, et)],
     "  " + is + " = alloca i64\n",
     "  store i64 " + idxop + ", ptr " + is + "\n",
     arm.3, c + 1)
  } :
  arm.0 == "armtup" ? {
    e2:  &[(str, str)] := env
    pre: &str := ""
    cc:  &int := c
    arm.1 @ (i: nm => {
      fty := tup_field(et, i)
      fld := `%fld{cc}`
      pre = pre + "  " + fld + " = getelementptr " + lltype(et) + ", ptr " + es + ", i32 0, i32 " + `{i}` + "\n"
      e2 = e2 + [(nm, fld, fty)]
      cc = cc + 1
      ()
    })
    (e2, pre, "", arm.2, cc)
  } :
  (env + [(arm.1, es, et)], "", "", arm.2, c)            // plain ( name => stmt )
}

// bind a ctor pattern's fields: load the payload struct from `plr`, then bind each
// named field (`_` skips a field) as a fresh local. -> (env', instructions, counter).
bind_pat := (pat: (str, str), env: [(str, str)], plr: str, c: int) -> ([(str, str)], str, int) {
  pat.0 == "pctor" && pat.2.len > 0 ? {
    marker := lookup_type(env, pat.1)                    // ("ctor", tag, typename, [fieldtypes])
    ftypes := marker.3
    pll := "{" + tup_ll(ftypes) + "}"
    ps  := `%t{c}`
    ir: &str := "  " + ps + " = load " + pll + ", ptr " + plr + "\n"
    e2: &[(str, str)] := env
    cc: &int := c + 1
    pat.2 @ (j: bn => {
      bn != "_" ? {
        fty  := ftypes[j]
        fll  := lltype(fty)
        fv   := `%t{cc}`
        slot := `%s{cc + 1}`
        ir = ir + "  " + fv + " = extractvalue " + pll + " " + ps + ", " + `{j}` + "\n" +
          "  " + slot + " = alloca " + fll + "\n  store " + fll + " " + fv + ", ptr " + slot + "\n"
        e2 = e2 + [(bn, slot, fty)]
        cc = cc + 2
      } : ()
      ()
    })
    (e2, ir, cc)
  } :
  (env, "", c)                                           // wildcard / nullary: nothing to bind
}

// subj ? { pat => res … } — dispatch on the variant tag. Each arm tests its case
// tag (a `_` wildcard matches unconditionally), binds its fields, runs its result,
// and stores into a shared slot; no arm matching yields () (flag false). The arm
// result type (taken from the first arm) types the slot. -> (ir, value, flag, type, c).
gen_match := (node: (str, str), env: [(str, str)], c: int) -> (str, str, str, str, int) {
  arms := node.2
  sir, sv, sf, st, c1 := gen_expr(node.1, env, c)
  L    := `{c1}`
  tagr := `%t{c1}`
  plr  := `%t{c1 + 1}`
  resslot  := `%mr{c1}`
  flagslot := `%mf{c1}`
  head := sir +
    "  " + tagr + " = extractvalue {i64, ptr} " + sv + ", 0\n" +
    "  " + plr  + " = extractvalue {i64, ptr} " + sv + ", 1\n"
  rty:  &str := "i64"
  rgty: &str := "i64"
  disp: &str := ""
  cc:   &int := c1 + 2
  i:    &int := 0
  na := arms.len
  { i < na } @ {
    arm := arms[i]
    pat := arm.1
    benv, bir, c2 := bind_pat(pat, env, plr, cc)
    si, renv, c3, rop, rfl, rt := gen_stmt(arm.2, benv, c2)
    i == 0 ? { rty = lltype(rt); rgty = rt } : ()
    ropv := rop == "" ? (rty == "i64" ? "0" : "zeroinitializer") : rop  // an effect arm yields ()
    test: &str := ""
    pat.0 == "pwild" ? {
      test = "  br label %arm" + L + "_" + `{i}` + "\n"
      cc = c3
    } :
    {
      marker := lookup_type(env, pat.1)
      cmp := `%t{c3}`
      test = "  " + cmp + " = icmp eq i64 " + tagr + ", " + marker.1 + "\n" +
        "  br i1 " + cmp + ", label %arm" + L + "_" + `{i}` + ", label %nx" + L + "_" + `{i}` + "\n"
      cc = c3 + 1
    }
    disp = disp + test +
      "arm" + L + "_" + `{i}` + ":\n" + bir + si +
      "  store " + rty + " " + ropv + ", ptr " + resslot + "\n" +
      "  store i1 " + rfl + ", ptr " + flagslot + "\n" +
      "  br label %mend" + L + "\n" +
      "nx" + L + "_" + `{i}` + ":\n"
    i = i + 1
    ()
  }
  zero := rty == "i64" ? "0" : "zeroinitializer"
  v := `%t{cc}`
  f := `%t{cc + 1}`
  body := head +
    "  " + resslot + " = alloca " + rty + "\n" +
    "  " + flagslot + " = alloca i1\n" +
    disp +
    "  store " + rty + " " + zero + ", ptr " + resslot + "\n" +
    "  store i1 false, ptr " + flagslot + "\n" +
    "  br label %mend" + L + "\n" +
    "mend" + L + ":\n" +
    "  " + v + " = load " + rty + ", ptr " + resslot + "\n" +
    "  " + f + " = load i1, ptr " + flagslot + "\n"
  (body, v, f, rgty, cc + 2)
}

// gen_expr -> (instructions, value-operand, i1 present-flag, type, next-counter).
// type is "i64" or "str"; `flag` is "true" for an always-present value, a
// dynamic i1 for a one-armed `?` or an `@` find.
gen_expr := (node: (str, str), env: [(str, str)], c: int) -> (str, str, str, str, int) {
  node.0 == "block" ? gen_block(node.1, env, c) :
  node.0 == "match" ? gen_match(node, env, c) :
  node.0 == "unit" ? ("", "0", "false", "i64", c) :    // () — absent
  node.0 == "int"  ? ("", node.1, "true", "i64", c) :
  node.0 == "str"  ? {                                  // literal -> fat {len, ptr}
    txt := node.1
    ln  := txt.len
    lns := `{ln}`
    p  := `%t{c}`
    v  := `%t{c + 1}`
    v2 := `%t{c + 2}`
    head := "  " + p + " = call ptr @__alloc(i64 " + lns + ")\n"
    store := ln == 0 ? "" :
      "  store [" + lns + " x i8] c\"" + escape_ll(txt) + "\", ptr " + p + "\n"
    pack := "  " + v + " = insertvalue {i64, ptr} undef, i64 " + lns + ", 0\n" +
      "  " + v2 + " = insertvalue {i64, ptr} " + v + ", ptr " + p + ", 1\n"
    (head + store + pack, v2, "true", "str", c + 3)
  } :
  node.0 == "name" ? {
    ty := lookup_type(env, node.1)
    slot := lookup(env, node.1)
    is_ctor(ty) ? {                                      // a nullary variant: {tag, null}
      v0 := `%t{c}`
      v1 := `%t{c + 1}`
      ("  " + v0 + " = insertvalue {i64, ptr} undef, i64 " + ty.1 + ", 0\n" +
       "  " + v1 + " = insertvalue {i64, ptr} " + v0 + ", ptr null, 1\n",
       v1, "true", ("var", ty.2), c + 2)
    } :
    is_fn(ty) ? {                                        // a function value
      slot[0] == "@" ?
        ("", slot, "true", ty, c) :                      // top-level fn: its address @name
        { reg := `%t{c}`                                 // fn-valued param: load the code ptr
          ("  " + reg + " = load ptr, ptr " + slot + "\n", reg, "true", ty, c + 1) }
    } :
    { reg := `%t{c}`
      ("  " + reg + " = load " + lltype(ty) + ", ptr " + slot + "\n", reg, "true", ty, c + 1) }
  } :
  node.0 == "tuple" ? {                                 // (a, b, ...) -> aggregate
    eir, ops, tys, c1 := gen_elems(node.1, env, c)
    tty := ("tup", tys)
    llt := lltype(tty)
    acc: &str := "undef"
    body: &str := eir
    cc:  &int := c1
    ops @ (i: op => {
      reg := `%t{cc}`
      body = body + "  " + reg + " = insertvalue " + llt + " " + acc + ", " +
        lltype(tys[i]) + " " + op + ", " + `{i}` + "\n"
      acc = reg
      cc = cc + 1
      ()
    })
    (body, acc, "true", tty, cc)
  } :
  node.0 == "list" ? {                                 // [e0, e1, ...] -> {len, cap, ptr}
    node.1.len == 0 ? {                                // empty: {0, 0, null}
      r0 := `%t{c}`
      r1 := `%t{c + 1}`
      r2 := `%t{c + 2}`
      ("  " + r0 + " = insertvalue {i64, i64, ptr} undef, i64 0, 0\n" +
       "  " + r1 + " = insertvalue {i64, i64, ptr} " + r0 + ", i64 0, 1\n" +
       "  " + r2 + " = insertvalue {i64, i64, ptr} " + r1 + ", ptr null, 2\n",
       r2, "true", ("lst", "i64"), c + 3)
    } :
    {
      eir, ops, tys, c1 := gen_elems(node.1, env, c)
      et  := tys[0]
      etl := lltype(et)
      n   := `{node.1.len}`
      endp := `%t{c1}`
      bytes := `%t{c1 + 1}`
      base := `%t{c1 + 2}`
      body: &str := eir +
        "  " + endp + " = getelementptr " + etl + ", ptr null, i64 " + n + "\n" +
        "  " + bytes + " = ptrtoint ptr " + endp + " to i64\n" +
        "  " + base + " = call ptr @__alloc(i64 " + bytes + ")\n"
      cc: &int := c1 + 3
      ops @ (i: op => {
        ep := `%t{cc}`
        body = body + "  " + ep + " = getelementptr " + etl + ", ptr " + base + ", i64 " + `{i}` + "\n" +
          "  store " + etl + " " + op + ", ptr " + ep + "\n"
        cc = cc + 1
        ()
      })
      v0 := `%t{cc}`
      v1 := `%t{cc + 1}`
      v2 := `%t{cc + 2}`
      body = body + "  " + v0 + " = insertvalue {i64, i64, ptr} undef, i64 " + n + ", 0\n" +
        "  " + v1 + " = insertvalue {i64, i64, ptr} " + v0 + ", i64 " + n + ", 1\n" +
        "  " + v2 + " = insertvalue {i64, i64, ptr} " + v1 + ", ptr " + base + ", 2\n"
      (body, v2, "true", ("lst", et), cc + 3)
    }
  } :
  node.0 == "member" ? {
    oir, ov, of, ot, c1 := gen_expr(node.1, env, c)
    reg := `%t{c1}`
    node.2 == "len" ?                                   // str/list length field 0
      (oir + "  " + reg + " = extractvalue " + lltype(ot) + " " + ov + ", 0\n", reg, "true", "i64", c1 + 1) :
      {                                                 // numeric tuple field .N
        fty := tup_field(ot, fieldnum(node.2))
        (oir + "  " + reg + " = extractvalue " + lltype(ot) + " " + ov + ", " + node.2 + "\n",
         reg, "true", fty, c1 + 1)
      }
  } :
  node.0 == "index" ? {                                 // obj[i]
    oir, ov, of, ot, c1 := gen_expr(node.1, env, c)
    iir, iv, iff, it, c2 := gen_expr(node.2, env, c1)
    ot == "str" ? {                                     // s[i] -> shared 1-char str
      bp := `%t{c2}`
      elt := `%t{c2 + 1}`
      v0 := `%t{c2 + 2}`
      v1 := `%t{c2 + 3}`
      (oir + iir +
       "  " + bp + " = extractvalue {i64, ptr} " + ov + ", 1\n" +
       "  " + elt + " = getelementptr i8, ptr " + bp + ", i64 " + iv + "\n" +
       "  " + v0 + " = insertvalue {i64, ptr} undef, i64 1, 0\n" +
       "  " + v1 + " = insertvalue {i64, ptr} " + v0 + ", ptr " + elt + ", 1\n",
       v1, "true", "str", c2 + 4)
    } :
    {                                                  // xs[i] -> element via typed gep
      et  := elemtype(ot)
      etl := lltype(et)
      bp  := `%t{c2}`
      ep  := `%t{c2 + 1}`
      elt := `%t{c2 + 2}`
      (oir + iir +
       "  " + bp + " = extractvalue {i64, i64, ptr} " + ov + ", 2\n" +
       "  " + ep + " = getelementptr " + etl + ", ptr " + bp + ", i64 " + iv + "\n" +
       "  " + elt + " = load " + etl + ", ptr " + ep + "\n",
       elt, "true", et, c2 + 3)
    }
  } :
  node.0 == "call" && node.1 == "fs.read" ? {           // host: read a whole file -> str
    air, ops, c2 := gen_args(node.2, env, c)
    reg := `%t{c2}`
    (air + "  " + reg + " = call {i64, ptr} @__read(" + ops + ")\n", reg, "true", "str", c2 + 1)
  } :
  node.0 == "call" && node.1 == "fs.write" ? {          // host: write a str to a file -> ()
    air, ops, c2 := gen_args(node.2, env, c)
    (air + "  call void @__write(" + ops + ")\n", "0", "false", "i64", c2)
  } :
  node.0 == "call" && is_ctor(lookup_type(env, node.1)) ? {  // variant construction
    marker := lookup_type(env, node.1)                  // ("ctor", tag, typename, [fieldtypes])
    ftypes := marker.3
    pll := "{" + tup_ll(ftypes) + "}"                   // the payload struct layout
    air, ops, tys, c1 := gen_elems(node.2, env, c)
    acc:  &str := "undef"
    body: &str := air
    cc:   &int := c1
    ops @ (i: op => {                                    // build the payload struct value
      reg := `%t{cc}`
      body = body + "  " + reg + " = insertvalue " + pll + " " + acc + ", " +
        lltype(ftypes[i]) + " " + op + ", " + `{i}` + "\n"
      acc = reg
      cc = cc + 1
      ()
    })
    szp := `%t{cc}`
    szb := `%t{cc + 1}`
    mem := `%t{cc + 2}`
    v0  := `%t{cc + 3}`
    v1  := `%t{cc + 4}`
    body = body +                                        // alloc the payload, store it, pack {tag, ptr}
      "  " + szp + " = getelementptr " + pll + ", ptr null, i64 1\n" +
      "  " + szb + " = ptrtoint ptr " + szp + " to i64\n" +
      "  " + mem + " = call ptr @__alloc(i64 " + szb + ")\n" +
      "  store " + pll + " " + acc + ", ptr " + mem + "\n" +
      "  " + v0 + " = insertvalue {i64, ptr} undef, i64 " + marker.1 + ", 0\n" +
      "  " + v1 + " = insertvalue {i64, ptr} " + v0 + ", ptr " + mem + ", 1\n"
    (body, v1, "true", ("var", marker.2), cc + 5)
  } :
  node.0 == "call" ? {
    cir, callee, cf, ct, c1 := gen_expr(("name", node.1), env, c)  // @name or a loaded fn ptr
    air, ops, c2 := gen_args(node.2, env, c1)
    rt := ct.1                                          // ("fn", rettype) -> rettype
    reg := `%t{c2}`
    (cir + air + "  " + reg + " = call " + lltype(rt) + " " + callee + "(" + ops + ")\n",
     reg, "true", rt, c2 + 1)
  } :
  node.0 == "if" ? {
    cir, tag, c1 := gen_cond(node.1, env, c)
    res := `%r{c1}`
    tir, tv, tf, tt, c3 := gen_expr(node.2, env, c1 + 1)
    eir, ev, ef, et, c4 := gen_expr(node.3, env, c3)
    rty := lltype(tt)
    L := `{c4}`                                       // shared label suffix
    body := cir + "  " + res + " = alloca " + rty + "\n" +
      "  br i1 " + tag + ", label %then" + L + ", label %else" + L + "\n" +
      "then" + L + ":\n" + tir + "  store " + rty + " " + tv + ", ptr " + res +
        "\n  br label %merge" + L + "\n" +
      "else" + L + ":\n" + eir + "  store " + rty + " " + ev + ", ptr " + res +
        "\n  br label %merge" + L + "\n" +
      "merge" + L + ":\n"
    reg := `%t{c4 + 1}`
    (body + "  " + reg + " = load " + rty + ", ptr " + res + "\n", reg, "true", tt, c4 + 2)
  } :
  node.0 == "try" ? {                                  // cond ? then -> present|()
    cir, tag, c1 := gen_cond(node.1, env, c)
    vp := `%rp{c1}`
    fp := `%rf{c1}`
    tir, tv, tf, tt, c3 := gen_expr(node.2, env, c1 + 1)
    rty  := lltype(tt)
    zero := zerov(tt)
    L := `{c3}`
    body := cir + "  " + vp + " = alloca " + rty + "\n  " + fp + " = alloca i1\n" +
      "  br i1 " + tag + ", label %some" + L + ", label %none" + L + "\n" +
      "some" + L + ":\n" + tir +
        "  store " + rty + " " + tv + ", ptr " + vp + "\n  store i1 " + tf + ", ptr " + fp +
        "\n  br label %end" + L + "\n" +
      "none" + L + ":\n  store " + rty + " " + zero + ", ptr " + vp + "\n  store i1 false, ptr " + fp +
        "\n  br label %end" + L + "\n" +
      "end" + L + ":\n"
    v := `%t{c3}`
    f := `%t{c3 + 1}`
    (body + "  " + v + " = load " + rty + ", ptr " + vp + "\n" +
            "  " + f + " = load i1, ptr " + fp + "\n", v, f, tt, c3 + 2)
  } :
  node.0 == "rel" ? {                                  // yields the right operand (present) or ()
    la, lv, lf, lt, c1 := gen_expr(node.2, env, c)
    ra, rv, rf, rt, c2 := gen_expr(node.3, env, c1)
    rll := lltype(rt)
    lt == "str" ? {
      sc := `%t{c2}`
      cmp := `%t{c2 + 1}`
      sel := `%t{c2 + 2}`
      (la + ra + "  " + sc + " = call i64 @__strcmp({i64, ptr} " + lv + ", {i64, ptr} " + rv + ")\n" +
       "  " + cmp + " = icmp " + relpred(node.1) + " i64 " + sc + ", 0\n" +
       "  " + sel + " = select i1 " + cmp + ", " + rll + " " + rv + ", " + rll + " " + zerov(rt) + "\n",
       sel, cmp, rt, c2 + 3)
    } :
    {
      cmp := `%t{c2}`
      sel := `%t{c2 + 1}`
      (la + ra + "  " + cmp + " = icmp " + relpred(node.1) + " i64 " + lv + ", " + rv + "\n" +
       "  " + sel + " = select i1 " + cmp + ", " + rll + " " + rv + ", " + rll + " " + zerov(rt) + "\n",
       sel, cmp, rt, c2 + 2)
    }
  } :
  node.0 == "iter" ? {                                 // src @|# (name => body)
    src := node.2
    arm := node.3
    src.0 == "block" ? {                               // { cond } @ { body } — while loop
      // the condition is the block's final expression, re-checked each iteration
      // as a real condition (so int relations test their icmp, not a value).
      cstmts := src.1
      condexpr := cstmts[cstmts.len - 1].1
      cir, ctag, c1 := gen_cond(condexpr, env, c)
      L := `{c1}`
      bir, bv, bf, bt, c2 := gen_expr(arm, env, c1)
      ("  br label %wc" + L + "\n" +
       "wc" + L + ":\n" + cir +
       "  br i1 " + ctag + ", label %wb" + L + ", label %we" + L + "\n" +
       "wb" + L + ":\n" + bir + "  br label %wc" + L + "\n" +
       "we" + L + ":\n", "0", "false", "i64", c2)
    } :
    src.0 == "range" && arm.0 == "arm" ? {
      // a `..` range counts the element from lo to hi inclusive; the arm's
      // bound name IS the counter slot, so the body reads it like any local.
      lir, lov, lf, lt, c1 := gen_expr(src.1, env, c)
      hir, hiv, hf, ht, c2 := gen_expr(src.2, env, c1)
      L  := `{c2}`
      iv := `%iv{c2}`
      bir, be, c3, bop, bflag, bty := gen_stmt(arm.2, env + [(arm.1, iv, "i64")], c2 + 1)
      head := lir + hir +
        "  " + iv + " = alloca i64\n  store i64 " + lov + ", ptr " + iv + "\n" +
        "  br label %lc" + L + "\n" +
        "lc" + L + ":\n  %ic" + L + " = load i64, ptr " + iv + "\n" +
        "  %cm" + L + " = icmp sle i64 %ic" + L + ", " + hiv + "\n" +
        "  br i1 %cm" + L + ", label %lb" + L + ", label %le" + L + "\n" +
        "lb" + L + ":\n" + bir
      step := "  %in" + L + " = load i64, ptr " + iv + "\n  %nx" + L + " = add i64 %in" + L + ", 1\n" +
        "  store i64 %nx" + L + ", ptr " + iv + "\n  br label %lc" + L + "\n"
      bflag == "false" ? {
        (head + step + "le" + L + ":\n", "0", "false", "i64", c3)
      } :
      gen_find(head, step, L, bop, bflag, bty, c3)
    } :
    arm.0 == "arm" || arm.0 == "armidx" || arm.0 == "armtup" ? {  // list source
      sir, sv, sf, st, c1 := gen_expr(src, env, c)
      et  := elemtype(st)
      etl := lltype(et)
      L  := `{c1}`
      lp := `%lp{c1}`
      ln := `%ln{c1}`
      iv := `%iv{c1}`
      es := `%es{c1}`
      benv, pre, bodypre, stmt, c1b := bind_arm(arm, es, et, "%ic" + L, env, c1 + 1)
      bir, be, c3, bop, bflag, bty := gen_stmt(stmt, benv, c1b)
      head := sir +
        "  " + ln + " = extractvalue {i64, i64, ptr} " + sv + ", 0\n" +
        "  " + lp + " = extractvalue {i64, i64, ptr} " + sv + ", 2\n" +
        "  " + iv + " = alloca i64\n  store i64 0, ptr " + iv + "\n" +
        "  " + es + " = alloca " + etl + "\n" + pre +
        "  br label %lc" + L + "\n" +
        "lc" + L + ":\n  %ic" + L + " = load i64, ptr " + iv + "\n" +
        "  %cm" + L + " = icmp slt i64 %ic" + L + ", " + ln + "\n" +
        "  br i1 %cm" + L + ", label %lb" + L + ", label %le" + L + "\n" +
        "lb" + L + ":\n" +
        "  %ep" + L + " = getelementptr " + etl + ", ptr " + lp + ", i64 %ic" + L + "\n" +
        "  %ev" + L + " = load " + etl + ", ptr %ep" + L + "\n" +
        "  store " + etl + " %ev" + L + ", ptr " + es + "\n" + bodypre + bir
      step := "  %in" + L + " = load i64, ptr " + iv + "\n  %nx" + L + " = add i64 %in" + L + ", 1\n" +
        "  store i64 %nx" + L + ", ptr " + iv + "\n  br label %lc" + L + "\n"
      bflag == "false" ? {
        (head + step + "le" + L + ":\n", "0", "false", "i64", c3)
      } :
      gen_find(head, step, L, bop, bflag, bty, c3)
    } :
    ("", "0", "false", "i64", c)
  } :
  {                                                    // binary op
    la, lv, lf, lt, c1 := gen_expr(node.2, env, c)
    ra, rv, rf, rt, c2 := gen_expr(node.3, env, c1)
    lt == "str" && node.1 == "+" ? {                   // string concatenation
      al := `%t{c2}`
      ap := `%t{c2 + 1}`
      bl := `%t{c2 + 2}`
      bp := `%t{c2 + 3}`
      tot := `%t{c2 + 4}`
      np := `%t{c2 + 5}`
      dst := `%t{c2 + 6}`
      rv0 := `%t{c2 + 7}`
      rv1 := `%t{c2 + 8}`
      instr := la + ra +
        "  " + al + " = extractvalue {i64, ptr} " + lv + ", 0\n" +
        "  " + ap + " = extractvalue {i64, ptr} " + lv + ", 1\n" +
        "  " + bl + " = extractvalue {i64, ptr} " + rv + ", 0\n" +
        "  " + bp + " = extractvalue {i64, ptr} " + rv + ", 1\n" +
        "  " + tot + " = add i64 " + al + ", " + bl + "\n" +
        "  " + np + " = call ptr @__alloc(i64 " + tot + ")\n" +
        "  call void @llvm.memcpy.p0.p0.i64(ptr " + np + ", ptr " + ap + ", i64 " + al + ", i1 false)\n" +
        "  " + dst + " = getelementptr i8, ptr " + np + ", i64 " + al + "\n" +
        "  call void @llvm.memcpy.p0.p0.i64(ptr " + dst + ", ptr " + bp + ", i64 " + bl + ", i1 false)\n" +
        "  " + rv0 + " = insertvalue {i64, ptr} undef, i64 " + tot + ", 0\n" +
        "  " + rv1 + " = insertvalue {i64, ptr} " + rv0 + ", ptr " + np + ", 1\n"
      (instr, rv1, "true", "str", c2 + 9)
    } :
    lt != "i64" && lt != "str" && node.1 == "+" ? {     // list append (immutable copy): xs + ys
      et  := elemtype(lt)
      etl := lltype(et)
      instr := la + ra +
        "  %t" + `{c2}` + " = extractvalue {i64, i64, ptr} " + lv + ", 0\n" +
        "  %t" + `{c2 + 1}` + " = extractvalue {i64, i64, ptr} " + lv + ", 2\n" +
        "  %t" + `{c2 + 2}` + " = extractvalue {i64, i64, ptr} " + rv + ", 0\n" +
        "  %t" + `{c2 + 3}` + " = extractvalue {i64, i64, ptr} " + rv + ", 2\n" +
        "  %t" + `{c2 + 4}` + " = add i64 %t" + `{c2}` + ", %t" + `{c2 + 2}` + "\n" +
        "  %t" + `{c2 + 5}` + " = getelementptr " + etl + ", ptr null, i64 %t" + `{c2 + 4}` + "\n" +
        "  %t" + `{c2 + 6}` + " = ptrtoint ptr %t" + `{c2 + 5}` + " to i64\n" +
        "  %t" + `{c2 + 7}` + " = call ptr @__alloc(i64 %t" + `{c2 + 6}` + ")\n" +
        "  %t" + `{c2 + 8}` + " = getelementptr " + etl + ", ptr null, i64 %t" + `{c2}` + "\n" +
        "  %t" + `{c2 + 9}` + " = ptrtoint ptr %t" + `{c2 + 8}` + " to i64\n" +
        "  call void @llvm.memcpy.p0.p0.i64(ptr %t" + `{c2 + 7}` + ", ptr %t" + `{c2 + 1}` +
          ", i64 %t" + `{c2 + 9}` + ", i1 false)\n" +
        "  %t" + `{c2 + 10}` + " = getelementptr " + etl + ", ptr %t" + `{c2 + 7}` + ", i64 %t" + `{c2}` + "\n" +
        "  %t" + `{c2 + 11}` + " = getelementptr " + etl + ", ptr null, i64 %t" + `{c2 + 2}` + "\n" +
        "  %t" + `{c2 + 12}` + " = ptrtoint ptr %t" + `{c2 + 11}` + " to i64\n" +
        "  call void @llvm.memcpy.p0.p0.i64(ptr %t" + `{c2 + 10}` + ", ptr %t" + `{c2 + 3}` +
          ", i64 %t" + `{c2 + 12}` + ", i1 false)\n" +
        "  %t" + `{c2 + 13}` + " = insertvalue {i64, i64, ptr} undef, i64 %t" + `{c2 + 4}` + ", 0\n" +
        "  %t" + `{c2 + 14}` + " = insertvalue {i64, i64, ptr} %t" + `{c2 + 13}` + ", i64 %t" + `{c2 + 4}` + ", 1\n" +
        "  %t" + `{c2 + 15}` + " = insertvalue {i64, i64, ptr} %t" + `{c2 + 14}` + ", ptr %t" + `{c2 + 7}` + ", 2\n"
      (instr, "%t" + `{c2 + 15}`, "true", lt, c2 + 16)
    } :
    boolop(node.1) ? {                                  // && present-guard / || present-select
      pir, ptag, c3 := gen_present(lv, lt, c2)
      sel := `%t{c3}`
      node.1 == "&&" ?
        (la + ra + pir + "  " + sel + " = select i1 " + ptag + ", " + lltype(rt) + " " + rv +
           ", " + lltype(rt) + " " + zerov(rt) + "\n", sel, "true", rt, c3 + 1) :
        (la + ra + pir + "  " + sel + " = select i1 " + ptag + ", " + lltype(lt) + " " + lv +
           ", " + lltype(lt) + " " + rv + "\n", sel, "true", lt, c3 + 1)
    } :
    {
      reg := `%t{c2}`
      instr := la + ra + "  " + reg + " = " + llop(node.1) + " i64 " + lv + ", " + rv + "\n"
      (instr, reg, "true", "i64", c2 + 1)
    }
  }
}

// gen one statement -> (instructions, env', counter', value-op or "", flag, type).
// Stores/intros yield (), so their value-op is "" / flag "false"; a bare final
// expression carries its value, present-flag, AND type through (so `@` find can
// type its result slot).
// amortized in-place append of each element to the &[T] list in `slot`
// (load, push via @__push_n with capacity-doubling, store back). -> (ir, counter).
gen_push := (slot: str, lty: str, elems: [(str, str)], env: [(str, str)], c: int) -> (str, int) {
  et  := elemtype(lty)
  etl := lltype(et)
  cur := `%t{c}`
  szp := `%t{c + 1}`
  szb := `%t{c + 2}`
  ir:  &str := "  " + cur + " = load {i64, i64, ptr}, ptr " + slot + "\n" +
    "  " + szp + " = getelementptr " + etl + ", ptr null, i64 1\n" +
    "  " + szb + " = ptrtoint ptr " + szp + " to i64\n"
  acc: &str := cur
  cc:  &int := c + 3
  elems @ (e => {
    ei, eo, ef, etp, c2 := gen_expr(e, env, cc)
    tmp := `%t{c2}`
    nl  := `%t{c2 + 1}`
    ir = ir + ei +
      "  " + tmp + " = alloca " + etl + "\n  store " + etl + " " + eo + ", ptr " + tmp + "\n" +
      "  " + nl + " = call {i64, i64, ptr} @__push_n({i64, i64, ptr} " + acc +
        ", ptr " + tmp + ", i64 " + szb + ")\n"
    acc = nl
    cc = c2 + 2
    ()
  })
  (ir + "  store {i64, i64, ptr} " + acc + ", ptr " + slot + "\n", cc)
}

gen_stmt := (s: (str, str), env: [(str, str)], c: int) -> (str, [(str, str)], int, str, str, str) {
  s.0 == "let" ? {
    i2, op, of, ot, c2 := gen_expr(s.2, env, c)
    rty := lltype(ot)
    slot := `%s{c2}`
    (i2 + "  " + slot + " = alloca " + rty + "\n  store " + rty + " " + op + ", ptr " + slot + "\n",
     env + [(s.1, slot, ot)], c2 + 1, "", "false", "i64")
  } :
  s.0 == "letty" ? {                                    // name: Type := expr (annotated)
    aty := s.2                                          // the declared type
    rty := lltype(aty)
    i2, op, of, ot, c2 := gen_expr(s.3, env, c)
    slot := `%s{c2}`
    (i2 + "  " + slot + " = alloca " + rty + "\n  store " + rty + " " + op + ", ptr " + slot + "\n",
     env + [(s.1, slot, aty)], c2 + 1, "", "false", "i64")
  } :
  s.0 == "destruct" ? {                                 // a, b, ... := tuple-expr
    ri, ro, rf, rt, c2 := gen_expr(s.2, env, c)
    ir: &str := ri
    e2: &[(str, str)] := env
    cc: &int := c2
    s.1 @ (i: nm => {
      fty := tup_field(rt, i)
      fll := lltype(fty)
      val  := `%t{cc}`
      slot := `%s{cc + 1}`
      ir = ir + "  " + val + " = extractvalue " + lltype(rt) + " " + ro + ", " + `{i}` + "\n" +
        "  " + slot + " = alloca " + fll + "\n  store " + fll + " " + val + ", ptr " + slot + "\n"
      e2 = e2 + [(nm, slot, fty)]
      cc = cc + 2
      ()
    })
    (ir, e2, cc, "", "false", "i64")
  } :
  s.0 == "store" ? {
    lty := lookup_type(env, s.1)
    slot := lookup(env, s.1)
    rhs := s.2
    // self-append  xs = xs + [ ... ]  on a &[T]  ->  amortized in-place push.
    // Intermediate bindings required: gridi lexes chained numeric members
    // (rhs.2.0) as a float, so each access must be a single .N on a bound value.
    is_list(lty) && rhs.0 == "bin" ? {
      lhs := rhs.2
      rl  := rhs.3
      rhs.1 == "+" && lhs.0 == "name" && lhs.1 == s.1 && rl.0 == "list" ? {
        pir, c2 := gen_push(slot, lty, rl.1, env, c)
        (pir, env, c2, "", "false", "i64")
      } :
      {
        i2, op, of, ot, c2 := gen_expr(rhs, env, c)
        (i2 + "  store " + lltype(lty) + " " + op + ", ptr " + slot + "\n", env, c2, "", "false", "i64")
      }
    } :
    {
      i2, op, of, ot, c2 := gen_expr(s.2, env, c)
      (i2 + "  store " + lltype(lty) + " " + op + ", ptr " + slot + "\n", env, c2, "", "false", "i64")
    }
  } :
  s.0 == "inplace" ? {
    lty := lookup_type(env, s.1)
    slot := lookup(env, s.1)
    rl := s.3
    is_list(lty) && s.2 == "+=" && rl.0 == "list" ? {     // xs += [ ... ]  ->  in-place push
      pir, c2 := gen_push(slot, lty, rl.1, env, c)
      (pir, env, c2, "", "false", "i64")
    } :
    {
      // x op= e  is  x = x op e; reuse gen_expr's typed binary by rewriting it.
      expanded := ("bin", iop(s.2), ("name", s.1), s.3)
      i2, op, of, ot, c2 := gen_expr(expanded, env, c)
      (i2 + "  store " + lltype(lty) + " " + op + ", ptr " + slot + "\n", env, c2, "", "false", "i64")
    }
  } :
  { i2, op, of, ot, c2 := gen_expr(s.1, env, c); (i2, env, c2, op, of, ot) }
}

gen_body := (stmts: [(str, str)], env0: [(str, str)], c0: int, retll: str) -> str {
  ir:  &str := ""
  env: &[(str, str)] := env0
  c:   &int := c0
  ret: &str := retll == "i64" ? "0" : "zeroinitializer"
  stmts @ (s => {
    si, e2, c2, op, of, ot := gen_stmt(s, env, c)
    ir = ir + si
    env = e2
    c = c2
    op != "" ? { ret = op } : ()
    ()
  })
  ir + "  ret " + retll + " " + ret + "\n"
}

// a { block } in expression position: run its statements, yield the last value.
gen_block := (stmts: [(str, str)], env: [(str, str)], c: int) -> (str, str, str, str, int) {
  ir:  &str := ""
  e:   &[(str, str)] := env
  cc:  &int := c
  val: &str := "0"
  fl:  &str := "false"                                 // an effect-only block yields ()
  ty:  &str := "i64"
  stmts @ (s => {
    si, e2, c2, op, of, ot := gen_stmt(s, e, cc)
    ir = ir + si
    e = e2
    cc = c2
    op != "" ? { val = op; fl = of; ty = ot } : ()
    ()
  })
  (ir, val, fl, ty, cc)
}

// ("fn", name, params, rettype, stmts) -> a complete `define`. ftab seeds the
// env with every top-level function's signature so calls resolve return types.
gen_fn := (fn: (str, str), ftab: [(str, str)]) -> str {
  name   := fn.1
  params := fn.2                                        // [(name, type)]
  rty    := fn.3
  stmts  := fn.4
  retll  := lltype(rty)
  sig:   &str := ""
  setup: &str := ""
  env0:  &[(str, str)] := ftab
  params @ (i: pr => {
    pty  := pr.1
    pll  := lltype(pty)
    pp   := `%a{i}`
    slot := `%a{i}_addr`
    sig   = sig + (i == 0 ? "" : ", ") + pll + " " + pp
    setup = setup + "  " + slot + " = alloca " + pll + "\n  store " + pll + " " + pp + ", ptr " + slot + "\n"
    env0  = env0 + [(pr.0, slot, pty)]
    ()
  })
  "define " + retll + " @" + name + "(" + sig + ") {\n" +
  "entry:\n" + setup + gen_body(stmts, env0, 0, retll) + "}\n"
}

// the module preamble: a static bump arena (allocate, never free until exit;
// zero syscalls for memory) and the one intrinsic we lean on for concat.
preamble := () -> str {
  "; gridc\n" +
  "@arena = global [268435456 x i8] zeroinitializer\n" +
  "@hp = global i64 0\n" +
  "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n" +
  "define ptr @__alloc(i64 %n) {\n" +
  "  %a = add i64 %n, 7\n  %r = and i64 %a, -8\n" +
  "  %h = load i64, ptr @hp\n" +
  "  %p = getelementptr [268435456 x i8], ptr @arena, i64 0, i64 %h\n" +
  "  %h2 = add i64 %h, %r\n  store i64 %h2, ptr @hp\n  ret ptr %p\n}\n" +
  // lexicographic compare of two fat strings -> negative / 0 / positive
  "define i64 @__strcmp({i64, ptr} %a, {i64, ptr} %b) {\n" +
  "entry:\n" +
  "  %alen = extractvalue {i64, ptr} %a, 0\n  %aptr = extractvalue {i64, ptr} %a, 1\n" +
  "  %blen = extractvalue {i64, ptr} %b, 0\n  %bptr = extractvalue {i64, ptr} %b, 1\n" +
  "  %alt = icmp slt i64 %alen, %blen\n  %min = select i1 %alt, i64 %alen, i64 %blen\n" +
  "  %ip = alloca i64\n  store i64 0, ptr %ip\n  br label %loop\n" +
  "loop:\n  %i = load i64, ptr %ip\n  %done = icmp sge i64 %i, %min\n" +
  "  br i1 %done, label %bylen, label %body\n" +
  "body:\n  %ap = getelementptr i8, ptr %aptr, i64 %i\n  %bp = getelementptr i8, ptr %bptr, i64 %i\n" +
  "  %ac = load i8, ptr %ap\n  %bc = load i8, ptr %bp\n  %ne = icmp ne i8 %ac, %bc\n" +
  "  br i1 %ne, label %diff, label %cont\n" +
  "cont:\n  %i2 = add i64 %i, 1\n  store i64 %i2, ptr %ip\n  br label %loop\n" +
  "diff:\n  %az = zext i8 %ac to i64\n  %bz = zext i8 %bc to i64\n  %d = sub i64 %az, %bz\n  ret i64 %d\n" +
  "bylen:\n  %ld = sub i64 %alen, %blen\n  ret i64 %ld\n}\n" +
  // format a non-negative i64 to a decimal fat string in the arena
  "define {i64, ptr} @__itoa(i64 %n) {\n" +
  "entry:\n  %z = icmp eq i64 %n, 0\n  br i1 %z, label %zero, label %count\n" +
  "zero:\n  %zb = call ptr @__alloc(i64 1)\n  store i8 48, ptr %zb\n" +
  "  %zv0 = insertvalue {i64, ptr} undef, i64 1, 0\n  %zv1 = insertvalue {i64, ptr} %zv0, ptr %zb, 1\n" +
  "  ret {i64, ptr} %zv1\n" +
  "count:\n  %lp = alloca i64\n  store i64 %n, ptr %lp\n  %cp = alloca i64\n  store i64 0, ptr %cp\n" +
  "  br label %cl\n" +
  "cl:\n  %lv = load i64, ptr %lp\n  %more = icmp sgt i64 %lv, 0\n  br i1 %more, label %cb, label %cd\n" +
  "cb:\n  %lv2 = sdiv i64 %lv, 10\n  store i64 %lv2, ptr %lp\n" +
  "  %cv = load i64, ptr %cp\n  %cv2 = add i64 %cv, 1\n  store i64 %cv2, ptr %cp\n  br label %cl\n" +
  "cd:\n  %nd = load i64, ptr %cp\n  %buf = call ptr @__alloc(i64 %nd)\n" +
  "  store i64 %n, ptr %lp\n  %ip = alloca i64\n  %im1 = sub i64 %nd, 1\n  store i64 %im1, ptr %ip\n" +
  "  br label %fl\n" +
  "fl:\n  %iv = load i64, ptr %ip\n  %ok = icmp sge i64 %iv, 0\n  br i1 %ok, label %fb, label %fd\n" +
  "fb:\n  %rem = load i64, ptr %lp\n  %dd = srem i64 %rem, 10\n  %rem2 = sdiv i64 %rem, 10\n  store i64 %rem2, ptr %lp\n" +
  "  %dc = add i64 %dd, 48\n  %dc8 = trunc i64 %dc to i8\n  %dst = getelementptr i8, ptr %buf, i64 %iv\n  store i8 %dc8, ptr %dst\n" +
  "  %iv2 = sub i64 %iv, 1\n  store i64 %iv2, ptr %ip\n  br label %fl\n" +
  "fd:\n  %rv0 = insertvalue {i64, ptr} undef, i64 %nd, 0\n  %rv1 = insertvalue {i64, ptr} %rv0, ptr %buf, 1\n" +
  "  ret {i64, ptr} %rv1\n}\n" +
  // amortized push: append esz bytes (*ep) to a {len,cap,ptr} list, doubling cap.
  // Sound for a uniquely-owned &[T] accumulator (no aliasing) -> in-place.
  "define {i64, i64, ptr} @__push_n({i64, i64, ptr} %l, ptr %ep, i64 %esz) {\n" +
  "entry:\n  %len = extractvalue {i64, i64, ptr} %l, 0\n  %cap = extractvalue {i64, i64, ptr} %l, 1\n" +
  "  %ptr = extractvalue {i64, i64, ptr} %l, 2\n  %full = icmp sge i64 %len, %cap\n" +
  "  br i1 %full, label %grow, label %put\n" +
  "grow:\n  %z = icmp eq i64 %cap, 0\n  %d = mul i64 %cap, 2\n  %nc = select i1 %z, i64 4, i64 %d\n" +
  "  %nb = mul i64 %nc, %esz\n  %np = call ptr @__alloc(i64 %nb)\n  %ob = mul i64 %len, %esz\n" +
  "  call void @llvm.memcpy.p0.p0.i64(ptr %np, ptr %ptr, i64 %ob, i1 false)\n  br label %put\n" +
  "put:\n  %fc = phi i64 [ %nc, %grow ], [ %cap, %entry ]\n  %fp = phi ptr [ %np, %grow ], [ %ptr, %entry ]\n" +
  "  %off = mul i64 %len, %esz\n  %dst = getelementptr i8, ptr %fp, i64 %off\n" +
  "  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %ep, i64 %esz, i1 false)\n" +
  "  %nl = add i64 %len, 1\n" +
  "  %o0 = insertvalue {i64, i64, ptr} undef, i64 %nl, 0\n  %o1 = insertvalue {i64, i64, ptr} %o0, i64 %fc, 1\n" +
  "  %o2 = insertvalue {i64, i64, ptr} %o1, ptr %fp, 2\n  ret {i64, i64, ptr} %o2\n}\n" +
  // ── the OS boundary: raw aarch64 Linux syscalls, no libc ──
  "define i64 @__sys(i64 %nr, i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5) {\n" +
  "  %r = call i64 asm sideeffect \"svc #0\", " +
    "\"={x0},{x8},{x0},{x1},{x2},{x3},{x4},{x5},~{memory}\"" +
    "(i64 %nr, i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5)\n  ret i64 %r\n}\n" +
  // llvm.memcpy lowers to a memcpy call; with -nostdlib we provide it ourselves.
  "define ptr @memcpy(ptr %d, ptr %s, i64 %n) {\n" +
  "entry:\n  %ip = alloca i64\n  store i64 0, ptr %ip\n  br label %ml\n" +
  "ml:\n  %i = load i64, ptr %ip\n  %dn = icmp sge i64 %i, %n\n  br i1 %dn, label %me, label %mb\n" +
  "mb:\n  %sp = getelementptr i8, ptr %s, i64 %i\n  %b = load i8, ptr %sp\n" +
  "  %dp = getelementptr i8, ptr %d, i64 %i\n  store i8 %b, ptr %dp\n" +
  "  %i2 = add i64 %i, 1\n  store i64 %i2, ptr %ip\n  br label %ml\n" +
  "me:\n  ret ptr %d\n}\n" +
  "define i64 @strlen(ptr %s) {\n" +
  "entry:\n  %ip = alloca i64\n  store i64 0, ptr %ip\n  br label %sl\n" +
  "sl:\n  %i = load i64, ptr %ip\n  %p = getelementptr i8, ptr %s, i64 %i\n  %c = load i8, ptr %p\n" +
  "  %z = icmp eq i8 %c, 0\n  br i1 %z, label %se, label %sb\n" +
  "sb:\n  %i2 = add i64 %i, 1\n  store i64 %i2, ptr %ip\n  br label %sl\n" +
  "se:\n  %r = load i64, ptr %ip\n  ret i64 %r\n}\n" +
  // fs.read: openat(AT_FDCWD, path, O_RDONLY) -> read loop into the arena -> close
  "define {i64, ptr} @__read({i64, ptr} %path) {\n" +
  "entry:\n  %pp = extractvalue {i64, ptr} %path, 1\n  %pi = ptrtoint ptr %pp to i64\n" +
  "  %fd = call i64 @__sys(i64 56, i64 -100, i64 %pi, i64 0, i64 0, i64 0, i64 0)\n" +
  "  %buf = call ptr @__alloc(i64 67108864)\n  %bi = ptrtoint ptr %buf to i64\n" +
  "  %tp = alloca i64\n  store i64 0, ptr %tp\n  br label %rl\n" +
  "rl:\n  %t = load i64, ptr %tp\n  %dst = add i64 %bi, %t\n  %room = sub i64 67108864, %t\n" +
  "  %k = call i64 @__sys(i64 63, i64 %fd, i64 %dst, i64 %room, i64 0, i64 0, i64 0)\n" +
  "  %le = icmp sle i64 %k, 0\n  br i1 %le, label %rd, label %ra\n" +
  "ra:\n  %t2 = add i64 %t, %k\n  store i64 %t2, ptr %tp\n  br label %rl\n" +
  "rd:\n  %total = load i64, ptr %tp\n" +
  "  %cl = call i64 @__sys(i64 57, i64 %fd, i64 0, i64 0, i64 0, i64 0, i64 0)\n" +
  "  %r0 = insertvalue {i64, ptr} undef, i64 %total, 0\n  %r1 = insertvalue {i64, ptr} %r0, ptr %buf, 1\n" +
  "  ret {i64, ptr} %r1\n}\n" +
  // fs.write: openat(AT_FDCWD, path, O_WRONLY|O_CREAT|O_TRUNC, 0644) -> write -> close
  "define void @__write({i64, ptr} %path, {i64, ptr} %content) {\n" +
  "entry:\n  %pp = extractvalue {i64, ptr} %path, 1\n  %pi = ptrtoint ptr %pp to i64\n" +
  "  %fd = call i64 @__sys(i64 56, i64 -100, i64 %pi, i64 577, i64 420, i64 0, i64 0)\n" +
  "  %cl = extractvalue {i64, ptr} %content, 0\n  %cp = extractvalue {i64, ptr} %content, 1\n" +
  "  %ci = ptrtoint ptr %cp to i64\n" +
  "  %w = call i64 @__sys(i64 64, i64 %fd, i64 %ci, i64 %cl, i64 0, i64 0, i64 0)\n" +
  "  %c = call i64 @__sys(i64 57, i64 %fd, i64 0, i64 0, i64 0, i64 0, i64 0)\n  ret void\n}\n"
}

// the libc-free entry point. For main() -> call + exit_group; for
// main(args: [str]) -> a naked _start grabs sp and hands argv to gridc_start,
// which marshals argv[1..] into a [str] list (each str points at the original
// NUL-terminated C string, so paths flow straight into openat) and calls main.
start_stub := (np: int) -> str {
  np == 0 ?
    "define void @_start() {\n  %r = call i64 @main()\n" +
    "  %e = call i64 @__sys(i64 94, i64 %r, i64 0, i64 0, i64 0, i64 0, i64 0)\n  unreachable\n}\n" :
    "define void @_start() #nk {\n" +
    "  call void asm sideeffect \"mov x0, sp\\0Abl gridc_start\", \"\"()\n  unreachable\n}\n" +
    "attributes #nk = { naked noreturn }\n" +
    "define void @gridc_start(ptr %sp) {\n" +
    "entry:\n  %argc = load i64, ptr %sp\n  %n = sub i64 %argc, 1\n" +
    "  %bytes = mul i64 %n, 16\n  %base = call ptr @__alloc(i64 %bytes)\n" +
    "  %ip = alloca i64\n  store i64 0, ptr %ip\n  br label %gl\n" +
    "gl:\n  %i = load i64, ptr %ip\n  %dn = icmp sge i64 %i, %n\n  br i1 %dn, label %ge, label %gb\n" +
    "gb:\n  %ai = add i64 %i, 2\n  %off = mul i64 %ai, 8\n  %ap = getelementptr i8, ptr %sp, i64 %off\n" +
    "  %cstr = load ptr, ptr %ap\n  %sl = call i64 @strlen(ptr %cstr)\n" +
    "  %sv0 = insertvalue {i64, ptr} undef, i64 %sl, 0\n  %sv1 = insertvalue {i64, ptr} %sv0, ptr %cstr, 1\n" +
    "  %slot = getelementptr {i64, ptr}, ptr %base, i64 %i\n  store {i64, ptr} %sv1, ptr %slot\n" +
    "  %i2 = add i64 %i, 1\n  store i64 %i2, ptr %ip\n  br label %gl\n" +
    "ge:\n  %l0 = insertvalue {i64, i64, ptr} undef, i64 %n, 0\n" +
    "  %l1 = insertvalue {i64, i64, ptr} %l0, i64 %n, 1\n  %l2 = insertvalue {i64, i64, ptr} %l1, ptr %base, 2\n" +
    "  %r = call i64 @main({i64, i64, ptr} %l2)\n" +
    "  %e = call i64 @__sys(i64 94, i64 %r, i64 0, i64 0, i64 0, i64 0, i64 0)\n  unreachable\n}\n"
}

gen := (fns: [(str, str)]) -> str {
  // env seed: the runtime helper, every fn's signature, and every variant case's
  // constructor marker ("ctor", tag, typename, [fieldtypes]) — tag = case index.
  ftab: &[(str, str)] := [("__itoa", "@__itoa", ("fn", "str"))]
  fns @ (f => {
    f.0 == "fn" ? { ftab = ftab + [(f.1, "@" + f.1, ("fn", f.3))] } :
    f.0 == "variant" ? {
      cs := f.2
      cs @ (i: c => { ftab = ftab + [(c.1, "@ctor", ("ctor", `{i}`, f.1, c.2))]; () })
    } : ()
    ()
  })
  out: &str := preamble()
  fns @ (f => { f.0 == "fn" ? { out = out + gen_fn(f, ftab) } : (); () })
  np: &int := 0
  fns @ (f => { f.0 == "fn" && f.1 == "main" ? { ps := f.2; np = ps.len } : (); () })
  out + start_stub(np)
}

main := (args: [str]) -> int {
  src := fs.read(args[0])
  fs.write(args[1], gen(parse_program(lex(src))))
  0
}
