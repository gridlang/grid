// The converged control model, by example. Companion to dispatch.md / branch.md / blocks.md.
//
//   ?   test / if-let  — the consequent's topic is the subject's value
//   ?:  two-outcome branch — the loosest operator, right-associative
//   =>  match + commit — an ordinary operator: match the block's topic, bind, and on a
//       match return the result immediately (even if it is ())
//   a block is one scope run in sequence; the topic threads as the last *present* value
//
// Run: python -m gridi examples/control-converged.grid

module main
import sys
import str

sys.println("=== converged control model ===")

// ── if-let (bare =>) : bind the present value, with a ?: fallback ────────────
sys.println("")
sys.println("-- if-let (bare =>) --")
m = ["host": "grid.dev"]
sys.println(`  m["host"] -> {m["host"] ? v => str.upper(v) : "none"}`)
sys.println(`  m["port"] -> {m["port"] ? v => str.upper(v) : "none"}`)

// ── effectful dispatch (#1) : a matched arm that does effects commits ────────
//    no `; 1` sentinel needed — the match itself is the decision, not the value.
sys.println("")
sys.println("-- effectful dispatch --")
ok: &int = 0
other: &int = 0
status = 200
status ? {
  200 => { ok += 1; () }
  _   => { other += 1; () }
}
sys.println(`  hit 200 -> ok={ok} other={other}   (other stays 0: no fall-through)`)

// ── compute-then-dispatch : a prelude shifts the topic, then arms match it ───
sys.println("")
sys.println("-- compute-then-dispatch (topic threading) --")
route = (raw: str) -> str {
  raw ? {
    str.upper(raw)            // present result -> becomes the topic the arms match
    "GET"  => "read"
    "POST" => "write"
    _      => "unknown"
  }
}
sys.println(`  get post put -> {route("get")} {route("post")} {route("put")}`)

// ── guard ladder : chained ?: (right-associative), no cross-arm fall-through ──
sys.println("")
sys.println("-- guard ladder (chained ?:) --")
grade = (n: int) -> str {
  n >= 90 ? "A" : n >= 80 ? "B" : n >= 70 ? "C" : "F"
}
sys.println(`  95 85 75 65 -> {grade(95)} {grade(85)} {grade(75)} {grade(65)}`)

// ── if-let on a relation : `<` yields its right operand, which `=>` binds ─────
sys.println("")
sys.println("-- if-let on a relation --")
limit = 10
sys.println(`  7 < limit binds {limit} -> {7 < limit ? bound => bound * 2 : -1}`)
