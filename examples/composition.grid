// composition.grid — advanced compositional flow in Grid.
// Every example here is executed by the test suite, so it all really runs:
//   python -m gridi examples/composition.grid

// 1) PIPELINE — map -> filter -> reduce, chained in one breath.
//    Sum of the squares of the odd numbers in 1..10.
odd_sq_sum: &int = 0
1..10 # { (_, n) => n % 2 == 1 ? n } # { (_, n) => n * n } @ { (_, s) => odd_sq_sum += s }
//    odds [1,3,5,7,9] -> squares [1,9,25,49,81] -> 165

// 2) NESTED # — a # inside a #'s arm builds a multiplication table.
table = 1..3 # { (_, r) => 1..3 # { (_, c) => r * c } }
//    [[1,2,3],[2,4,6],[3,6,9]]

// 3) TRANSFORM then FIND — # builds the squares, @ stops at the first that
//    passes (a present body value exits the loop).
first_big_sq = 1..20 # { (_, n) => n * n } @ { (_, s) => s > 50 ? s }
//    64 (the first square over 50)

// 4) RUNNING FOLD — a stateful map: each arm mutates the accumulator and then
//    yields it, so # collects the prefix sums.
running: &int = 0
prefix_sums = 1..5 # { (_, n) => { running += n; running } }
//    [1, 3, 6, 10, 15]

// 5) STREAM as a filter — >> emits only what passes; the stream is then mapped.
evens = (xs: [int]) >> int { xs @ { (_, x) => x % 2 == 0 ? >> x } }
even_squares = evens(1..10) # { (_, n) => n * n }
//    evens [2,4,6,8,10] -> [4,16,36,64,100]

// 6) STREAM over STREAM — one generator consumes another. `take` threads over
//    whatever it is given (list OR stream), emitting the first k.
take = (xs: [int], k: int) >> int { xs @ { (i, x) => i < k ? >> x } }
first_three_evens = take(evens(1..100), 3) # { (_, n) => n }
//    [2, 4, 6]

// 7) GUARD + MATCH in one block — infix-? guard arms and a => wildcard arm,
//    side by side; the first present arm wins.
classify = (n: int) -> str {
  n ? {
    n > 99     ? "big"     // guard arm: fires when n > 99 succeeds
    n % 2 == 0 ? "even"    // guard arm
    _          => "odd"    // match arm: the topic always matches
  }
}
labelled = 1..6 # { (_, n) => classify(n) }
//    [odd, even, odd, even, odd, even]

`1) {odd_sq_sum}
2) {table}
3) {first_big_sq}
4) {prefix_sums}
5) {even_squares}
6) {first_three_evens}
7) {labelled}`
