// The Grid flagship — a tiny HTTP server, written against the grid.md model.
// Exercises every layer at once: := / =, the triad, =>-match, keyed iteration,
// fallibles + !, ~ defer, structs, interpolation, and the keyless control flow.
module main

import net          // listen / accept / readline / read / write / close, and Conn
import str          // words / lines / trim / join
import sys          // print

// --- types : a struct is a named tuple ---------------------------------
Request  := (method: str, path: str, body: str)
Response := (status: int, body: str)

// --- responses : plain functions ---------------------------------------
ok   := (body: str)             -> Response { (status: 200, body: body) }
fail := (status: int, msg: str) -> Response { (status: status, body: msg) }

// --- handlers : `?` makes the subject the current argument; `=>` matches it
hello := (req: Request) -> Response {
  name := req.body ? {
    ""  => "world"          // literal arm: body is exactly ""
    raw => str.trim(raw)    // else bind the value
  }
  ok(`hello, {name}!`)
}

echo := (req: Request) -> Response { ok(req.body) }

lines := (req: Request) -> Response {
  // keyed fan-out: `i` is the index, `line` the value
  numbered := str.lines(req.body) # (i: line => `{i + 1}: {line}`)
  ok(str.join(numbered, "\n"))
}

// --- routing : match a tuple of (method, path) positionally ------------
route := (req: Request) -> Response {
  (req.method, req.path) ? {
    ("GET",  "/hello") => hello(req)
    ("GET",  "/echo")  => echo(req)
    ("POST", "/lines") => lines(req)
    (m, p)             => fail(404, `no route: {m} {p}`)
  }
}

// --- request parsing : `-> T ! E` is fallible, `!` propagates ----------
read_request := (c: net.Conn) -> Request ! str {
  parts := str.words(net.readline(c)!)
  parts ? {
    [method, path, _] => {
      { net.readline(c)! != "" } @ { () }       // skip headers: loop until the blank line
      body := net.read(c, 8192)!
      (method: method, path: path, body: body)
    }
    _ => "bad request line"!                      // raise this error value
  }
}

// --- per connection : `~` defers cleanup; the bare `@` loops till `!` escapes
handle := (c: net.Conn, id: int) -> () ! str {
  ~net.close(c)
  sys.print(`[{id}] open\n`)
  @ {
    resp := route(read_request(c)!)
    net.write(c, `HTTP/1.1 {resp.status}\r\n\r\n{resp.body}`)!
    ()                                            // body yields () -> keep looping
  }
}

// --- accept loop -------------------------------------------------------
serve := (addr: str) -> () ! str {
  listener := net.listen(addr)!
  id: &int := 0
  @ {
    c := net.accept(listener)!                    // a failed accept is fatal -> propagates
    id += 1
    handle(c, id)                                 // its own failures stay local (dropped)
    ()
  }
}

// --- entry : main is not fallible, so it handles the error by hand -----
main := (args: [str]) -> int {
  addr := args[0] || "0.0.0.0:8080"
  sys.print(`listening on {addr}\n`)
  _, err := serve(addr)
  err ? { e => { sys.print(`fatal: {e}\n`); 1 } } : 0
}
